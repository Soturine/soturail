   try {
+    const decoded = decodeURIComponent(requestPath.split("?")[0]);
+    if (decoded.includes("\0")) throw new Error("bad path");
+    // Strip leading separators so the path is always relative to the root.
+    const candidate = path.resolve(publicRoot, decoded.replace(/^[/\\]+/, ""));
+    // Resolve symlinks on both sides so links can't escape the root either.
+    const realRoot = await fs.realpath(publicRoot);
+    const target = await fs.realpath(candidate);
+    const rel = path.relative(realRoot, target);
+    if (rel === ".." || rel.startsWith(".." + path.sep) || path.isAbsolute(rel)) {
+      throw new Error("outside root");
+    }
     const body = await fs.readFile(target);
     return { status: 200, type: TYPES[path.extname(target)] ?? "application/octet-stream", body };
