+
+test("configFor does not leak overrides into defaults or other tenants", async () => {
+  const { configFor } = await import("../src/tenants.js");
+  const { DEFAULTS } = await import("../src/defaults.js");
+  configFor("acme");
+  assert.equal(DEFAULTS.http.timeoutMs, 5000);
+  assert.equal(DEFAULTS.http.retry.attempts, 2);
+  assert.equal(configFor("initech").http.timeoutMs, 5000);
+  assert.equal(configFor("globex").http.retry.attempts, 2);
+  assert.equal(configFor("globex").http.retry.backoffMs, 100);
+});
