 Options:
@@ -13,3 +14,9 @@ Options:
 - `limit` (positive integer, required) — requests allowed per key per window.
 - `windowMs` (positive integer, required) — window length.
 - `now` (function, optional) — clock, defaults to `Date.now`. Windows start at multiples of `windowMs`.
+- `overrides` (object or `Map`, optional) — per-key limits (key -> positive integer) that replace `limit` for those keys.
+
+Methods:
+
+- `tryAcquire(key)` — consumes one request; returns `false` when the key's limit is exhausted.
+- `remaining(key)` — requests the key can still make in the current window (its override, or `limit`, minus use; never below 0). Does not consume budget.
diff --git a/src/limiter.js b/src/limiter.js
index 5e2455e..d7d2e29 100644
--- a/src/limiter.js
+++ b/src/limiter.js
@@ -2,11 +2,17 @@ function assertPositiveInteger(name, value) {
   if (!Number.isInteger(value) || value <= 0) throw new RangeError(`${name} must be a positive integer`);
 }
 
-export function createLimiter({ limit, windowMs, now = Date.now }) {
+export function createLimiter({ limit, windowMs, now = Date.now, overrides = {} }) {
   assertPositiveInteger("limit", limit);
   assertPositiveInteger("windowMs", windowMs);
+  const limits = new Map(overrides instanceof Map ? overrides : Object.entries(overrides ?? {}));
+  for (const [key, value] of limits) assertPositiveInteger(`overrides[${String(key)}]`, value);
   const counters = new Map();
 
+  function limitFor(key) {
+    return limits.has(key) ? limits.get(key) : limit;
+  }
+
   function bucket(key) {
     const windowStart = Math.floor(now() / windowMs) * windowMs;
     const current = counters.get(key);
@@ -21,9 +27,15 @@ export function createLimiter({ limit, windowMs, now = Date.now }) {
   return {
     tryAcquire(key) {
       const entry = bucket(key);
-      if (entry.count >= limit) return false;
+      if (entry.count >= limitFor(key)) return false;
       entry.count += 1;
       return true;
+    },
+    remaining(key) {
+      const windowStart = Math.floor(now() / windowMs) * windowMs;
+      const current = counters.get(key);
+      const used = current && current.windowStart === windowStart ? current.count : 0;
+      return Math.max(0, limitFor(key) - used);
     }
   };
 }
diff --git a/test/limiter.test.js b/test/limiter.test.js
index e3eaf9d..af250e5 100644
--- a/test/limiter.test.js
+++ b/test/limiter.test.js
@@ -15,3 +15,19 @@ test("blocks after limit within a window and resets next window", () => {
 test("validates options", () => {
   assert.throws(() => createLimiter({ limit: 0, windowMs: 10 }), RangeError);
 });
+
+test("per-key overrides and remaining", () => {
+  let t = 0;
+  const limiter = createLimiter({ limit: 2, windowMs: 1000, now: () => t, overrides: { vip: 3 } });
+  assert.equal(limiter.remaining("a"), 2);
+  assert.equal(limiter.remaining("vip"), 3);
+  limiter.tryAcquire("a");
+  assert.equal(limiter.remaining("a"), 1);
+  for (let i = 0; i < 3; i++) assert.equal(limiter.tryAcquire("vip"), true);
+  assert.equal(limiter.tryAcquire("vip"), false);
+  assert.equal(limiter.remaining("vip"), 0);
+  t = 1000;
+  assert.equal(limiter.remaining("vip"), 3);
+  assert.equal(limiter.remaining("toString"), 2);
+  assert.throws(() => createLimiter({ limit: 1, windowMs: 10, overrides: { x: 0 } }), RangeError);
+});
