diff --git a/src/static.js b/src/static.js
index f2f38b9..1427dcf 100644
--- a/src/static.js
+++ b/src/static.js
@@ -3,14 +3,35 @@ import path from "node:path";
 
 const TYPES = { ".html": "text/html", ".css": "text/css", ".txt": "text/plain" };
 
+const notFound = () => ({ status: 404, type: "text/plain", body: Buffer.from("not found") });
+
+function isInside(root, target) {
+  const rel = path.relative(root, target);
+  return rel !== "" && !rel.startsWith("..") && !path.isAbsolute(rel);
+}
+
 // Resolves a request path such as "/css/site.css" against the public root.
 export async function serveStatic(publicRoot, requestPath) {
-  const decoded = decodeURIComponent(requestPath.split("?")[0]);
-  const target = path.join(publicRoot, decoded);
+  let decoded;
+  try {
+    decoded = decodeURIComponent(requestPath.split("?")[0]);
+  } catch {
+    return notFound();
+  }
+  if (decoded.includes("\0")) return notFound();
+
+  const root = path.resolve(publicRoot);
+  // Strip leading separators so an absolute-looking path cannot replace the root.
+  const target = path.resolve(root, "." + path.sep + decoded.replace(/^[/\\]+/, ""));
+  if (!isInside(root, target)) return notFound();
+
   try {
-    const body = await fs.readFile(target);
-    return { status: 200, type: TYPES[path.extname(target)] ?? "application/octet-stream", body };
+    // Resolve symlinks so a link inside the root cannot point outside it.
+    const real = await fs.realpath(target);
+    if (!isInside(await fs.realpath(root), real)) return notFound();
+    const body = await fs.readFile(real);
+    return { status: 200, type: TYPES[path.extname(real)] ?? "application/octet-stream", body };
   } catch {
-    return { status: 404, type: "text/plain", body: Buffer.from("not found") };
+    return notFound();
   }
 }
diff --git a/test/static.test.js b/test/static.test.js
index b9d6e6e..137141b 100644
--- a/test/static.test.js
+++ b/test/static.test.js
@@ -14,3 +14,18 @@ test("serves a nested file", async () => {
 test("missing file is 404", async () => {
   assert.equal((await serveStatic(root, "/nope.txt")).status, 404);
 });
+
+test("rejects traversal outside the public root", async () => {
+  for (const p of ["/../secret.env", "/%2e%2e/secret.env", "/..%2fsecret.env", "/css/../../secret.env", "/..\\secret.env", "/%2e%2e%5csecret.env", "/%00", "/%E0%A4%A"]) {
+    assert.equal((await serveStatic(root, p)).status, 404, p);
+  }
+});
+
+test("rejects absolute paths and sibling-prefix escapes", async () => {
+  assert.equal((await serveStatic(root, "/" + path.resolve("secret.env"))).status, 404);
+  assert.equal((await serveStatic(root, "/../public-evil/x")).status, 404);
+});
+
+test("still serves files with dots in the name", async () => {
+  assert.equal((await serveStatic(root, "/notes..v2.txt")).status, 200);
+});
