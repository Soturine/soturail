+"""Leitura de CSV de clientes exportado pelo ERP."""
+
+import csv
+import io
+
+
+def split_line(line):
+    rows = list(csv.reader([line], skipinitialspace=True))
+    return rows[0] if rows else []
+
+
+def parse_customers(text):
+    reader = csv.reader(io.StringIO(text, newline=""), skipinitialspace=True)
+    header = None
+    customers = []
+    for values in reader:
+        if not any(v.strip() for v in values):
+            continue
+        number = reader.line_num
+        if header is None:
+            header = values
+            continue
+        if len(values) != len(header):
+            raise ValueError(f"linha {number}: esperado {len(header)} campos, encontrado {len(values)}")
+        customers.append(dict(zip(header, values)))
+    return customers
