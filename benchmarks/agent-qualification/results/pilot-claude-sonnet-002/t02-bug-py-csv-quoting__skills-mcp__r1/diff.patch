 def split_line(line):
     fields = []
-    for raw in line.split(","):
-        value = raw.strip()
-        if len(value) >= 2 and value[0] == '"' and value[-1] == '"':
-            value = value[1:-1].replace('""', '"')
-        fields.append(value)
+    current = []
+    quoted = False  # campo iniciou com aspas
+    in_quotes = False
+    i = 0
+    while i < len(line):
+        ch = line[i]
+        if in_quotes:
+            if ch == '"':
+                if line[i + 1:i + 2] == '"':
+                    current.append('"')
+                    i += 1
+                else:
+                    in_quotes = False
+            else:
+                current.append(ch)
+        elif ch == '"' and not "".join(current).strip():
+            current = []
+            quoted = True
+            in_quotes = True
+        elif ch == ",":
+            fields.append(_finish(current, quoted))
+            current, quoted = [], False
+        elif quoted and ch.isspace():
+            pass  # espaço depois do fecha-aspas
+        else:
+            current.append(ch)
+        i += 1
+    fields.append(_finish(current, quoted))
     return fields
 
 
+def _finish(chars, quoted):
+    value = "".join(chars)
+    return value if quoted else value.strip()
+
