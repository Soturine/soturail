diff --git a/src/shipping.js b/src/shipping.js
index 29c8394..3908994 100644
--- a/src/shipping.js
+++ b/src/shipping.js
@@ -1,3 +1,24 @@
+const round2 = (n) => Math.round(n * 100) / 100;
+
 export function shippingFee({ subtotal, country, weightKg, express = false }) {
-  throw new Error("not implemented");
+  if (typeof weightKg !== "number" || !Number.isFinite(weightKg) || weightKg < 0) {
+    throw new RangeError("weightKg must be a non-negative number");
+  }
+
+  const domestic = country === "ES";
+
+  // R2 vs R4 conflict (see OPEN_QUESTIONS.md): left unresolved on purpose.
+  if (domestic && express && subtotal >= 50) {
+    throw new Error("unresolved requirement: express domestic order with subtotal >= 50 (see OPEN_QUESTIONS.md)");
+  }
+
+  let fee;
+  if (domestic) {
+    fee = subtotal >= 50 ? 0 : 4.9;
+  } else {
+    fee = 12 + 1.5 * Math.max(0, Math.floor(weightKg - 2));
+  }
+  if (express) fee += 6;
+
+  return round2(fee);
 }
diff --git a/test/shipping.test.js b/test/shipping.test.js
index 1dca596..eae2a7e 100644
--- a/test/shipping.test.js
+++ b/test/shipping.test.js
@@ -5,3 +5,28 @@ import { shippingFee } from "../src/shipping.js";
 test("module exports shippingFee", () => {
   assert.equal(typeof shippingFee, "function");
 });
+
+test("R1/R2 domestic", () => {
+  assert.equal(shippingFee({ subtotal: 20, country: "ES", weightKg: 1 }), 4.9);
+  assert.equal(shippingFee({ subtotal: 50, country: "ES", weightKg: 1 }), 0);
+});
+
+test("R3 international", () => {
+  assert.equal(shippingFee({ subtotal: 20, country: "FR", weightKg: 4.7 }), 15);
+  assert.equal(shippingFee({ subtotal: 20, country: "FR", weightKg: 1 }), 12);
+});
+
+test("R4 express (non-conflicting cases)", () => {
+  assert.equal(shippingFee({ subtotal: 20, country: "ES", weightKg: 1, express: true }), 10.9);
+  assert.equal(shippingFee({ subtotal: 20, country: "FR", weightKg: 4.7, express: true }), 21);
+});
+
+test("R4 vs R2 conflict stays unresolved", () => {
+  assert.throws(() => shippingFee({ subtotal: 60, country: "ES", weightKg: 1, express: true }), /unresolved/);
+});
+
+test("R5 invalid weight", () => {
+  assert.throws(() => shippingFee({ subtotal: 1, country: "ES", weightKg: -1 }), RangeError);
+  assert.throws(() => shippingFee({ subtotal: 1, country: "ES", weightKg: "2" }), RangeError);
+  assert.throws(() => shippingFee({ subtotal: 1, country: "ES", weightKg: NaN }), RangeError);
+});
