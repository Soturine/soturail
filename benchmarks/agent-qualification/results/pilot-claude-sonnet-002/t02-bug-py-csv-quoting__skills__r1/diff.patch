+"""Leitura de CSV de clientes exportado pelo ERP."""
+import csv
+import io
+
+
+def split_line(line):
+    rows = list(csv.reader([line], skipinitialspace=True))
+    return [value.strip() for value in rows[0]] if rows else []
+
+
+def parse_customers(text):
+    reader = csv.reader(io.StringIO(text), skipinitialspace=True)
+    header = None
+    customers = []
+    for values in reader:
+        if not any(value.strip() for value in values):
+            continue
+        values = [value.strip() for value in values]
+        if header is None:
+            header = values
+            continue
+        if len(values) != len(header):
+            raise ValueError(f"linha {reader.line_num}: esperado {len(header)} campos, encontrado {len(values)}")
+        customers.append(dict(zip(header, values)))
+    return customers
