   try {
+    const decoded = decodeURIComponent(requestPath.split("?")[0]);
+    if (decoded.includes("\0")) throw new Error("bad path");
+    const root = await fs.realpath(publicRoot);
+    // Strip leading separators so the path is always resolved relative to root.
+    const target = await fs.realpath(path.resolve(root, "." + path.sep + decoded.replace(/^[/\\]+/, "")));
