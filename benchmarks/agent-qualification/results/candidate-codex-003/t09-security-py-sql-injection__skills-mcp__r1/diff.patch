+        set_role(self.conn, "1 OR 1=1", "viewer")
+        self.assertEqual(get_user_by_email(self.conn, "ana@x.io")["role"], "admin")
+        self.assertEqual(get_user_by_email(self.conn, "bruno@x.io")["role"], "editor")
+
+    def test_invalid_role_does_not_modify_users(self):
+        before = search_users(self.conn, "")
