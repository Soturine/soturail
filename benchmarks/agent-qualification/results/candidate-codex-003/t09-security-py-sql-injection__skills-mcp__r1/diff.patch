+    def test_search_injection_is_data(self):
+        for payload in ("') OR 1=1 --", "'; DROP TABLE users; --"):
+            with self.subTest(payload=payload):
+                self.assertEqual(search_users(self.conn, payload), [])
+        self.assertEqual(len(search_users(self.conn, "")), 2)
+
+    def test_email_injection_is_data(self):
+        for payload in ("' OR 1=1 --", "'; DROP TABLE users; --"):
+            with self.subTest(payload=payload):
+                self.assertIsNone(get_user_by_email(self.conn, payload))
+        self.assertEqual(len(search_users(self.conn, "")), 2)
+
+    def test_quoted_values_round_trip(self):
+        seed(self.conn, [("O'Neil", "o'neil@x.io", "viewer")])
+        self.assertEqual([u["name"] for u in search_users(self.conn, "O'NE")], ["O'Neil"])
+        self.assertEqual(get_user_by_email(self.conn, "o'neil@x.io")["name"], "O'Neil")
+
+    def test_search_wildcards_are_literal(self):
+        for i, fragment in enumerate(("%", "_", "!", "!%_")):
+            name = f"User{fragment}Name"
+            seed(self.conn, [(name, f"literal{i}@x.io", "viewer")])
+            self.assertEqual([u["name"] for u in search_users(self.conn, fragment)], [name])
+
+    def test_missing_email(self):
+        self.assertIsNone(get_user_by_email(self.conn, "missing@x.io"))
+
+    def test_role_update_is_scoped(self):
+        set_role(self.conn, 2, "editor")
