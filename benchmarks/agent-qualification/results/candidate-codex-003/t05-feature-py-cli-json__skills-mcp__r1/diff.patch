+import json
+from pathlib import Path
 import subprocess
 import sys
+import tempfile
 import unittest
 
 
 class ReportTest(unittest.TestCase):
+    def run_report(self, *args):
+        return subprocess.run(
+            [sys.executable, "-m", "inventory", "report", *args],
+            capture_output=True, text=True, check=True,
+        ).stdout
+
+    def test_json_report(self):
+        rows = json.loads(self.run_report("data/stock.csv", "--format", "json"))
+        self.assertEqual(rows, [
+            {"sku": "A-100", "name": "Anchor", "quantity": 3, "low_stock": True},
+            {"sku": "B-200", "name": "Bolt M6", "quantity": 40, "low_stock": False},
+            {"sku": "C-310", "name": "Clamp 2in", "quantity": 5, "low_stock": False},
+        ])
+        for row in rows:
+            self.assertIs(type(row["quantity"]), int)
+            self.assertIs(type(row["low_stock"]), bool)
+
+    def test_json_custom_threshold(self):
+        rows = json.loads(self.run_report("data/stock.csv", "--format", "json", "--threshold", "6"))
+        self.assertEqual([row["low_stock"] for row in rows], [True, False, True])
+
+    def test_json_empty_report(self):
+        with tempfile.TemporaryDirectory() as directory:
+            path = Path(directory) / "empty.csv"
+            path.write_text("sku,name,quantity\n", encoding="utf-8")
+            self.assertEqual(json.loads(self.run_report(str(path), "--format", "json")), [])
+
+    def test_explicit_text_report(self):
+        self.assertEqual(
+            self.run_report("data/stock.csv", "--format", "text"),
+            self.run_report("data/stock.csv"),
+        )
+
     def test_text_report(self):
         out = subprocess.run([sys.executable, "-m", "inventory", "report", "data/stock.csv"], capture_output=True, text=True, check=True).stdout
         self.assertEqual(out.splitlines(), ["A-100  Anchor  3 LOW", "B-200  Bolt M6  40", "C-310  Clamp 2in  5"])
