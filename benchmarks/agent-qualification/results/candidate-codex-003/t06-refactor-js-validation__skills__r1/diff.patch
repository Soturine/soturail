diff --git a/test/handlers.test.js b/test/handlers.test.js
index 0bea9d7..4bc09fd 100644
--- a/test/handlers.test.js
+++ b/test/handlers.test.js
@@ -16,3 +16,50 @@ test("update rejects invalid age", () => {
   createUser(store, { email: "a@b.co", name: "Ana" });
   assert.equal(updateUser(store, 1, { age: 7 }).status, 422);
 });
+
+test("validation preserves error order and leaves stored users unchanged", () => {
+  const store = createStore();
+  const original = createUser(store, { email: "a@b.co", name: "Ana", age: 30 }).user;
+  const expected = {
+    status: 422,
+    errors: ["email: invalid", "name: must be 2-80 characters", "age: must be an integer between 13 and 130"]
+  };
+  assert.deepEqual(createUser(store, { email: null, name: " A ", age: 12 }), expected);
+  assert.deepEqual(updateUser(store, 1, { email: null, name: " A ", age: 12 }), expected);
+  assert.deepEqual(store.get(1), original);
+  assert.equal(store.get(2), undefined);
+});
+
+test("create requires fields while update preserves omitted and undefined fields", () => {
+  const store = createStore();
+  assert.deepEqual(createUser(store, {}), {
+    status: 422, errors: ["email: invalid", "name: must be 2-80 characters"]
+  });
+  const original = createUser(store, { email: "a@b.co", name: "Ana", age: 30 }).user;
+  assert.deepEqual(updateUser(store, 1, {}).user, original);
+  assert.deepEqual(updateUser(store, 1, { email: undefined, name: undefined, age: undefined }).user, original);
+  assert.deepEqual(updateUser(store, 99, null), { status: 404, errors: ["user: not found"] });
+});
+
+test("both handlers preserve normalization and validation boundaries", () => {
+  for (const age of [13, 130]) {
+    for (const name of ["Ab", "a".repeat(80)]) {
+      const store = createStore();
+      const input = { email: " A@B.CO ", name: ` ${name} `, age };
+      const expected = { id: 1, email: "a@b.co", name, age };
+      assert.deepEqual(createUser(store, input), { status: 201, user: expected });
+      assert.deepEqual(updateUser(store, 1, input), { status: 200, user: expected });
+    }
+  }
+  for (const age of [null, "13", 13.5, 12, 131, NaN, Infinity]) {
+    const store = createStore();
+    const input = { email: "a@b.co", name: "Ana", age };
+    assert.deepEqual(createUser(store, input), {
+      status: 422, errors: ["age: must be an integer between 13 and 130"]
+    });
+    createUser(store, { email: "a@b.co", name: "Ana" });
+    assert.deepEqual(updateUser(store, 1, { age }), {
+      status: 422, errors: ["age: must be an integer between 13 and 130"]
+    });
+  }
+});
