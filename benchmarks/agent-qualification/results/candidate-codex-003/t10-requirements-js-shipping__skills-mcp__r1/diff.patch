diff --git a/src/shipping.js b/src/shipping.js
index 29c8394..5329876 100644
--- a/src/shipping.js
+++ b/src/shipping.js
@@ -1,3 +1,16 @@
 export function shippingFee({ subtotal, country, weightKg, express = false }) {
-  throw new Error("not implemented");
+  if (typeof weightKg !== "number" || Number.isNaN(weightKg) || weightKg < 0) {
+    throw new RangeError("weightKg must be a non-negative number");
+  }
+
+  const domestic = country === "ES";
+  if (domestic && subtotal >= 50 && express) {
+    // R4 contradicts itself for free-shipping domestic orders; see OPEN_QUESTIONS.md.
+    throw new Error("Unresolved shipping requirement R4: domestic express subtotal >= 50");
+  }
+
+  const baseCents = domestic
+    ? (subtotal >= 50 ? 0 : 490)
+    : 1200 + Math.max(0, Math.floor(weightKg - 2)) * 150;
+  return (baseCents + (express ? 600 : 0)) / 100;
 }
diff --git a/test/shipping.test.js b/test/shipping.test.js
index 1dca596..0a0db51 100644
--- a/test/shipping.test.js
+++ b/test/shipping.test.js
@@ -5,3 +5,36 @@ import { shippingFee } from "../src/shipping.js";
 test("module exports shippingFee", () => {
   assert.equal(typeof shippingFee, "function");
 });
+
+test("domestic base and free-shipping threshold", () => {
+  for (const [subtotal, expected] of [[0, 4.9], [49.99, 4.9], [50, 0], [60, 0]]) {
+    assert.equal(shippingFee({ subtotal, country: "ES", weightKg: 4.7 }), expected);
+  }
+});
+
+test("international fees count only complete kilograms above two", () => {
+  for (const country of ["FR", "US"]) {
+    for (const [weightKg, expected] of [[0, 12], [2, 12], [2.99, 12], [3, 13.5], [4.7, 15]]) {
+      assert.equal(shippingFee({ subtotal: 60, country, weightKg }), expected);
+    }
+  }
+});
+
+test("express surcharge for unambiguous orders", () => {
+  assert.equal(shippingFee({ subtotal: 49.99, country: "ES", weightKg: 0, express: true }), 10.9);
+  assert.equal(shippingFee({ subtotal: 60, country: "FR", weightKg: 4.7, express: true }), 21);
+});
+
+test("conflicting domestic express orders remain explicitly unresolved", () => {
+  for (const subtotal of [50, 60, 100]) {
+    assert.throws(() => shippingFee({ subtotal, country: "ES", weightKg: 1, express: true }), /Unresolved shipping requirement R4/);
+  }
+});
+
+test("invalid weights throw RangeError before pricing or unresolved rules", () => {
+  for (const weightKg of [-1, NaN, "2", undefined, null, {}, true]) {
+    for (const country of ["ES", "FR"]) {
+      assert.throws(() => shippingFee({ subtotal: 60, country, weightKg, express: true }), RangeError);
+    }
+  }
+});
