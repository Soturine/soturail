diff --git a/test/merge.test.js b/test/merge.test.js
index db17da7..8e2790e 100644
--- a/test/merge.test.js
+++ b/test/merge.test.js
@@ -10,3 +10,39 @@ test("nested values are merged", () => {
   const merged = mergeConfig({ http: { timeoutMs: 1, keep: true } }, { http: { timeoutMs: 2 } });
   assert.deepEqual(merged, { http: { timeoutMs: 2, keep: true } });
 });
+
+test("merging does not modify either input", () => {
+  const base = { http: { timeoutMs: 5000, retry: { attempts: 2, backoffMs: 100 } } };
+  const override = { http: { timeoutMs: 30000, retry: { attempts: 5 } } };
+  const originalBase = structuredClone(base);
+  const originalOverride = structuredClone(override);
+
+  mergeConfig(base, override);
+
+  assert.deepEqual(base, originalBase);
+  assert.deepEqual(override, originalOverride);
+});
+
+test("returned nested objects and arrays are independent of both inputs", () => {
+  const base = { http: { retry: { attempts: 2 } }, regions: [{ name: "eu" }] };
+  const override = { headers: { tenant: "acme" }, endpoints: [{ host: "example" }] };
+  const originalBase = structuredClone(base);
+  const originalOverride = structuredClone(override);
+  const merged = mergeConfig(base, override);
+
+  merged.http.retry.attempts = 99;
+  merged.regions[0].name = "changed";
+  merged.headers.tenant = "changed";
+  merged.endpoints[0].host = "changed";
+
+  assert.deepEqual(base, originalBase);
+  assert.deepEqual(override, originalOverride);
+});
+
+test("arrays replace rather than merge and scalars preserve falsy values", () => {
+  assert.deepEqual(
+    mergeConfig({ values: [1, 2], enabled: true, count: 3, label: "base", extra: {} },
+      { values: [3], enabled: false, count: 0, label: "", extra: null }),
+    { values: [3], enabled: false, count: 0, label: "", extra: null }
+  );
+});
