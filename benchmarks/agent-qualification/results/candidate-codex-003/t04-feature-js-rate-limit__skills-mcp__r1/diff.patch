 });
+
+test("uses independent override and default budgets and resets at the boundary", () => {
+  let t = 999;
+  const limiter = createLimiter({
+    limit: 2, windowMs: 1000, now: () => t,
+    overrides: { small: 1, large: 3 }
+  });
+  for (const [key, budget] of [["small", 1], ["large", 3], ["default", 2]]) {
+    assert.equal(limiter.remaining(key), budget);
+    assert.equal(limiter.remaining(key), budget);
+    for (let i = 0; i < budget; i++) {
+      assert.equal(limiter.tryAcquire(key), true);
+      assert.equal(limiter.remaining(key), budget - i - 1);
+    }
+    assert.equal(limiter.tryAcquire(key), false);
+    assert.equal(limiter.remaining(key), 0);
+  }
+  t = 1000;
+  assert.equal(limiter.remaining("small"), 1);
+  assert.equal(limiter.remaining("large"), 3);
+  assert.equal(limiter.remaining("default"), 2);
+  assert.equal(limiter.tryAcquire("small"), true);
+  assert.equal(limiter.remaining("small"), 0);
+});
+
+test("remaining works without overrides and after skipping windows", () => {
+  let t = 0;
