diff --git a/src/shipping.js b/src/shipping.js
index 29c8394..d3a9153 100644
--- a/src/shipping.js
+++ b/src/shipping.js
@@ -1,3 +1,17 @@
 export function shippingFee({ subtotal, country, weightKg, express = false }) {
-  throw new Error("not implemented");
+  if (typeof weightKg !== "number" || Number.isNaN(weightKg) || weightKg < 0) {
+    throw new RangeError("weightKg must be a non-negative number");
+  }
+
+  const domestic = country === "ES";
+  if (domestic && subtotal >= 50 && express) {
+    throw new Error("Unresolved shipping requirement R4: see OPEN_QUESTIONS.md");
+  }
+
+  let feeCents = domestic
+    ? (subtotal >= 50 ? 0 : 490)
+    : 1200 + 150 * Math.max(0, Math.floor(weightKg - 2));
+
+  if (express) feeCents += 600;
+  return feeCents / 100;
 }
diff --git a/test/shipping.test.js b/test/shipping.test.js
index 1dca596..cba27c6 100644
--- a/test/shipping.test.js
+++ b/test/shipping.test.js
@@ -5,3 +5,40 @@ import { shippingFee } from "../src/shipping.js";
 test("module exports shippingFee", () => {
   assert.equal(typeof shippingFee, "function");
 });
+
+test("domestic shipping and free-shipping threshold", () => {
+  for (const [subtotal, expected] of [[0, 4.9], [49.99, 4.9], [50, 0], [60, 0]]) {
+    assert.equal(shippingFee({ subtotal, country: "ES", weightKg: 1 }), expected);
+  }
+});
+
+test("international shipping charges only complete kilograms above two", () => {
+  for (const [weightKg, expected] of [[0, 12], [2, 12], [2.99, 12], [3, 13.5], [4.7, 15]]) {
+    assert.equal(shippingFee({ subtotal: 60, country: "FR", weightKg }), expected);
+  }
+});
+
+test("express surcharge applies to unambiguous orders", () => {
+  assert.equal(shippingFee({ subtotal: 49.99, country: "ES", weightKg: 1, express: true }), 10.9);
+  assert.equal(shippingFee({ subtotal: 60, country: "FR", weightKg: 4.7, express: true }), 21);
+});
+
+test("contradictory domestic express cases remain explicitly unresolved", () => {
+  for (const subtotal of [50, 60, 100]) {
+    assert.throws(
+      () => shippingFee({ subtotal, country: "ES", weightKg: 1, express: true }),
+      /Unresolved shipping requirement R4: see OPEN_QUESTIONS\.md/,
+    );
+  }
+});
+
+test("invalid weights throw RangeError before computing any tariff", () => {
+  for (const weightKg of [-1, NaN, "2", null, undefined, {}, true]) {
+    for (const express of [false, true]) {
+      assert.throws(
+        () => shippingFee({ subtotal: 60, country: "ES", weightKg, express }),
+        RangeError,
+      );
+    }
+  }
+});
