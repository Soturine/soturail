 import test from "node:test";
 import assert from "node:assert/strict";
 import path from "node:path";
+import os from "node:os";
+import { promises as fs } from "node:fs";
 import { serveStatic } from "../src/static.js";
 
 const root = path.resolve("public");
@@ -14,3 +16,37 @@ test("serves a nested file", async () => {
 test("missing file is 404", async () => {
   assert.equal((await serveStatic(root, "/nope.txt")).status, 404);
 });
+
+test("serves valid names and ignores query strings", async () => {
+  for (const url of ["/notes..v2.txt", "/css/site.css?v=1", "/css/../index.html"]) {
+    assert.equal((await serveStatic(root, url)).status, 200, url);
+  }
+});
+
+test("rejects malformed paths without throwing", async () => {
+  for (const url of ["/%", "/%GG", "/%00", "/index.html:stream", "/C:/secret.env"]) {
+    assert.equal((await serveStatic(root, url)).status, 404, url);
+  }
+});
+
+test("blocks traversal, sibling prefixes, and symlink escapes", async (t) => {
+  const fixture = await fs.mkdtemp(path.join(os.tmpdir(), "asset-server-"));
+  t.after(() => fs.rm(fixture, { recursive: true, force: true }));
+  const publicDir = path.join(fixture, "public");
+  const sibling = path.join(fixture, "public-private");
+  await fs.mkdir(publicDir);
+  await fs.mkdir(sibling);
+  await fs.writeFile(path.join(fixture, "secret.env"), "outside secret");
+  await fs.writeFile(path.join(sibling, "secret.txt"), "sibling secret");
+  for (const url of [
+    "/../secret.env", "/%2e%2e/secret.env", "/..%2fsecret.env",
+    "/..\\secret.env", "/%2e%2e%5csecret.env",
+    "/../public-private/secret.txt", "/nested/../../secret.env",
+  ]) {
+    const res = await serveStatic(publicDir, url);
+    assert.equal(res.status, 404, url);
+    assert.equal(res.body.toString(), "not found", url);
+  }
+  await fs.symlink(sibling, path.join(publicDir, "linked"), process.platform === "win32" ? "junction" : "dir");
+  assert.equal((await serveStatic(publicDir, "/linked/secret.txt")).status, 404);
+});
