--- a/src/static.js
+++ b/src/static.js
@@ -3,12 +3,24 @@ import path from "node:path";
 
 const TYPES = { ".html": "text/html", ".css": "text/css", ".txt": "text/plain" };
 
+function isWithin(root, target) {
+  const relative = path.relative(root, target);
+  return relative !== ".." && !relative.startsWith(`..${path.sep}`) && !path.isAbsolute(relative);
+}
+
 // Resolves a request path such as "/css/site.css" against the public root.
 export async function serveStatic(publicRoot, requestPath) {
-  const decoded = decodeURIComponent(requestPath.split("?")[0]);
-  const target = path.join(publicRoot, decoded);
   try {
-    const body = await fs.readFile(target);
+    const decoded = decodeURIComponent(requestPath.split("?")[0]).replaceAll("\\", "/");
+    // Colons can select drive paths or NTFS alternate data streams on Windows.
+    if (decoded.includes("\0") || decoded.includes(":")) throw new Error("invalid path");
+    const root = path.resolve(publicRoot);
+    const target = path.resolve(root, `.${decoded.startsWith("/") ? "" : "/"}${decoded}`);
+    if (!isWithin(root, target)) throw new Error("outside public root");
+    const realRoot = await fs.realpath(root);
+    const realTarget = await fs.realpath(target);
+    if (!isWithin(realRoot, realTarget)) throw new Error("outside public root");
+    const body = await fs.readFile(realTarget);
     return { status: 200, type: TYPES[path.extname(target)] ?? "application/octet-stream", body };
   } catch {
     return { status: 404, type: "text/plain", body: Buffer.from("not found") };
