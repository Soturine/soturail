 import test from "node:test";
 import assert from "node:assert/strict";
 import { mergeConfig } from "../src/merge.js";
+import { DEFAULTS } from "../src/defaults.js";
+import { configFor } from "../src/tenants.js";
 
 test("override wins for scalars", () => {
   assert.equal(mergeConfig({ a: 1 }, { a: 2 }).a, 2);
@@ -10,3 +12,52 @@ test("nested values are merged", () => {
   const merged = mergeConfig({ http: { timeoutMs: 1, keep: true } }, { http: { timeoutMs: 2 } });
   assert.deepEqual(merged, { http: { timeoutMs: 2, keep: true } });
 });
+
+test("merging deeply frozen inputs does not mutate either input", () => {
+  const base = Object.freeze({
+    http: Object.freeze({ timeoutMs: 5000, retry: Object.freeze({ attempts: 2, backoffMs: 100 }) })
+  });
+  const override = Object.freeze({
+    http: Object.freeze({ retry: Object.freeze({ attempts: 5 }) })
+  });
+  assert.deepEqual(mergeConfig(base, override), {
+    http: { timeoutMs: 5000, retry: { attempts: 5, backoffMs: 100 } }
+  });
+});
+
+test("result mutations cannot change nested base or override values", () => {
+  const base = { untouched: { enabled: true }, regions: [{ name: "eu" }] };
+  const override = { added: { enabled: true }, replacements: [{ name: "us" }] };
+  const merged = mergeConfig(base, override);
+  merged.untouched.enabled = false;
+  merged.regions[0].name = "changed";
+  merged.added.enabled = false;
+  merged.replacements[0].name = "changed";
+  assert.deepEqual(base, { untouched: { enabled: true }, regions: [{ name: "eu" }] });
+  assert.deepEqual(override, { added: { enabled: true }, replacements: [{ name: "us" }] });
+});
+
+test("arrays and scalars replace base values", () => {
+  assert.deepEqual(mergeConfig({ regions: ["eu", "us"], http: { timeoutMs: 1 } }, {
+    regions: ["apac"], http: null
+  }), { regions: ["apac"], http: null });
+});
+
+test("tenant settings stay isolated across requests and caller mutations", () => {
+  const original = structuredClone(DEFAULTS);
+  for (const order of [["acme", "globex", "initech"], ["initech", "globex", "acme"]]) {
+    for (const tenant of order) {
+      const config = configFor(tenant);
+      assert.deepEqual(config.http, tenant === "acme"
+        ? { timeoutMs: 30000, retry: { attempts: 5, backoffMs: 100 } }
+        : original.http);
+      assert.deepEqual(config.headers, tenant === "globex"
+        ? { ...original.headers, "x-tenant": "globex" } : original.headers);
+      config.http.timeoutMs = 1;
+      config.http.retry.attempts = 99;
+      config.headers["user-agent"] = "changed";
+      config.allowedRegions.push("changed");
+      assert.deepEqual(DEFAULTS, original);
+    }
+  }
+});
