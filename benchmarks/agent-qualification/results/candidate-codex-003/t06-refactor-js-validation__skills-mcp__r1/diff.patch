+
+test("both handlers preserve validation errors and leave the store unchanged", () => {
+  const store = createStore();
+  const original = createUser(store, { email: "a@b.co", name: "Ana", age: 25 }).user;
+  for (const age of [12, 131, 13.5, "25", null, NaN, Infinity]) {
+    const input = { email: "invalid", name: " A ", age };
+    const expected = {
+      status: 422,
+      errors: ["email: invalid", "name: must be 2-80 characters", "age: must be an integer between 13 and 130"]
+    };
+    assert.deepEqual(createUser(store, input), expected);
+    assert.deepEqual(updateUser(store, 1, input), expected);
+    assert.strictEqual(store.get(1), original);
+  }
+  assert.equal(store.get(2), undefined);
+});
+
+test("both handlers accept boundary values and normalize fields", () => {
+  for (const [age, name] of [[13, "Ab"], [130, "A".repeat(80)]]) {
+    const store = createStore();
+    const input = { email: " A@B.CO ", name: ` ${name} `, age };
+    const expected = { id: 1, email: "a@b.co", name, age };
+    assert.deepEqual(createUser(store, input), { status: 201, user: expected });
+    assert.deepEqual(updateUser(store, 1, input), { status: 200, user: expected });
+  }
+});
