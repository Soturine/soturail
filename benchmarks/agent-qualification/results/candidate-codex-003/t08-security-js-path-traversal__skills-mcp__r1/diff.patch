 import test from "node:test";
 import assert from "node:assert/strict";
 import path from "node:path";
+import { promises as fs } from "node:fs";
+import os from "node:os";
 import { serveStatic } from "../src/static.js";
 
 const root = path.resolve("public");
@@ -14,3 +16,34 @@ test("serves a nested file", async () => {
 test("missing file is 404", async () => {
   assert.equal((await serveStatic(root, "/nope.txt")).status, 404);
 });
+
+test("rejects traversal without returning outside file contents", async (t) => {
+  const temp = await fs.mkdtemp(path.join(os.tmpdir(), "static-test-"));
+  t.after(() => fs.rm(temp, { recursive: true, force: true }));
+  const publicRoot = path.join(temp, "public");
+  await fs.mkdir(publicRoot);
+  await fs.mkdir(path.join(temp, "public-other"));
+  await fs.writeFile(path.join(temp, "outside.txt"), "outside fixture");
+  await fs.writeFile(path.join(temp, "public-other", "file.txt"), "outside fixture");
+  for (const request of ["/../outside.txt", "/%2e%2e/outside.txt", "/..%2foutside.txt",
+    "/%2e%2e%5coutside.txt", "/../public-other/file.txt", "/..\\outside.txt"]) {
+    const response = await serveStatic(publicRoot, request);
+    assert.equal(response.status, 404, request);
+    assert.equal(response.body.toString(), "not found");
+  }
+  await fs.symlink(temp, path.join(publicRoot, "link"), "junction");
+  assert.equal((await serveStatic(publicRoot, "/link/outside.txt")).status, 404);
+});
+
+test("malformed requests return 404", async () => {
+  for (const request of ["/%", "/%GG", "/%E0%A4", "/%00", "/C:/file.txt"]) {
+    assert.equal((await serveStatic(root, request)).status, 404, request);
+  }
+});
+
+test("preserves query strings, encoded names and names containing dots", async () => {
+  for (const request of ["/css/site.css?version=1", "/css/%73ite.css"]) {
+    assert.equal((await serveStatic(root, request)).status, 200);
+  }
+  assert.equal((await serveStatic(root, "/notes..v2.txt")).status, 200);
+});
