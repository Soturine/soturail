 import test from "node:test";
 import assert from "node:assert/strict";
 import { mergeConfig } from "../src/merge.js";
+import { configFor } from "../src/tenants.js";
+import { DEFAULTS } from "../src/defaults.js";
 
 test("override wins for scalars", () => {
   assert.equal(mergeConfig({ a: 1 }, { a: 2 }).a, 2);
@@ -10,3 +12,34 @@ test("nested values are merged", () => {
   const merged = mergeConfig({ http: { timeoutMs: 1, keep: true } }, { http: { timeoutMs: 2 } });
   assert.deepEqual(merged, { http: { timeoutMs: 2, keep: true } });
 });
+
+test("tenant requests preserve defaults regardless of request order", () => {
+  const expected = structuredClone(DEFAULTS);
+  for (const tenant of ["acme", "globex", "initech", "unknown", "acme", "globex"]) {
+    const config = configFor(tenant);
+    assert.deepEqual(config.http, tenant === "acme"
+      ? { timeoutMs: 30000, retry: { attempts: 5, backoffMs: 100 } }
+      : expected.http);
+    assert.deepEqual(config.headers, tenant === "globex"
+      ? { ...expected.headers, "x-tenant": "globex" }
+      : expected.headers);
+    assert.deepEqual(DEFAULTS, expected);
+  }
+});
+
+test("returned nested objects and arrays are independent of both inputs", () => {
+  const base = { http: { retry: { attempts: 2 } }, regions: [{ name: "eu" }] };
+  const override = { http: { timeoutMs: 30 }, extra: { flags: ["enabled"] }, regions: [{ name: "us" }] };
+  const baseBefore = structuredClone(base);
+  const overrideBefore = structuredClone(override);
+  const merged = mergeConfig(base, override);
+  merged.http.retry.attempts = 99;
+  merged.http.timeoutMs = 99;
+  merged.extra.flags.push("changed");
+  merged.regions[0].name = "changed";
+  const inherited = mergeConfig(base);
+  inherited.regions[0].name = "changed";
+  assert.deepEqual(base, baseBefore);
+  assert.deepEqual(override, overrideBefore);
+  assert.deepEqual(mergeConfig(base, override).regions, [{ name: "us" }]);
+});
