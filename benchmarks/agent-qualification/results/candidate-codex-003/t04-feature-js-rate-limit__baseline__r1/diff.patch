diff --git a/test/limiter.test.js b/test/limiter.test.js
index e3eaf9d..72ed928 100644
--- a/test/limiter.test.js
+++ b/test/limiter.test.js
@@ -15,3 +15,38 @@ test("blocks after limit within a window and resets next window", () => {
 test("validates options", () => {
   assert.throws(() => createLimiter({ limit: 0, windowMs: 10 }), RangeError);
 });
+
+test("overrides replace the default limit and budgets stay independent", () => {
+  const limiter = createLimiter({ limit: 2, windowMs: 1000, overrides: { low: 1, high: 3 } });
+  for (const [key, limit] of [["low", 1], ["high", 3], ["default", 2], ["toString", 2]]) {
+    assert.equal(limiter.remaining(key), limit);
+    assert.equal(limiter.remaining(key), limit);
+    for (let i = 0; i < limit; i++) {
+      assert.equal(limiter.tryAcquire(key), true);
+      assert.equal(limiter.remaining(key), limit - i - 1);
+    }
+    assert.equal(limiter.tryAcquire(key), false);
+    assert.equal(limiter.remaining(key), 0);
+  }
+});
+
+test("remaining resets at the window boundary for default and overridden keys", () => {
+  let t = 999;
+  const limiter = createLimiter({ limit: 2, windowMs: 1000, now: () => t, overrides: new Map([["a", 1]]) });
+  limiter.tryAcquire("a");
+  limiter.tryAcquire("b");
+  assert.equal(limiter.remaining("a"), 0);
+  assert.equal(limiter.remaining("b"), 1);
+  t = 1000;
+  assert.equal(limiter.remaining("a"), 1);
+  assert.equal(limiter.remaining("b"), 2);
+  assert.equal(limiter.tryAcquire("a"), true);
+});
+
+test("validates override limits", () => {
+  for (const value of [0, -1, 1.5, NaN, Infinity, "2", undefined]) {
+    for (const overrides of [{ a: value }, new Map([["a", value]])]) {
+      assert.throws(() => createLimiter({ limit: 2, windowMs: 1000, overrides }), RangeError);
+    }
+  }
+});
