+import json
+from pathlib import Path
 import subprocess
 import sys
+import tempfile
 import unittest
 
 
 class ReportTest(unittest.TestCase):
+    def run_report(self, contents, *args):
+        with tempfile.TemporaryDirectory() as directory:
+            path = Path(directory) / "stock.csv"
+            path.write_text(contents, encoding="utf-8")
+            return subprocess.run(
+                [sys.executable, "-m", "inventory", "report", str(path), *args],
+                capture_output=True, text=True, check=True,
+            ).stdout
+
+    def test_json_report(self):
+        contents = 'sku,name,quantity\nZ-2,"Bolt, large",8\nA-1,Anchor,3\nM-1,Clamp,5\n'
+        out = self.run_report(contents, "--format", "json")
+        items = json.loads(out)
+        self.assertEqual(items, [
+            {"sku": "A-1", "name": "Anchor", "quantity": 3, "low_stock": True},
+            {"sku": "M-1", "name": "Clamp", "quantity": 5, "low_stock": False},
+            {"sku": "Z-2", "name": "Bolt, large", "quantity": 8, "low_stock": False},
+        ])
+        for item in items:
+            self.assertIs(type(item["quantity"]), int)
+            self.assertIs(type(item["low_stock"]), bool)
+
+    def test_json_custom_threshold(self):
+        out = self.run_report("sku,name,quantity\nA,Anchor,5\n", "--format", "json", "--threshold", "6")
+        self.assertTrue(json.loads(out)[0]["low_stock"])
+
+    def test_json_empty_report(self):
+        self.assertEqual(json.loads(self.run_report("sku,name,quantity\n", "--format", "json")), [])
+
+    def test_explicit_text_matches_default(self):
+        contents = "sku,name,quantity\nB,Bolt,5\nA,Anchor,3\n"
+        self.assertEqual(self.run_report(contents, "--format", "text"), self.run_report(contents))
+
     def test_text_report(self):
         out = subprocess.run([sys.executable, "-m", "inventory", "report", "data/stock.csv"], capture_output=True, text=True, check=True).stdout
         self.assertEqual(out.splitlines(), ["A-100  Anchor  3 LOW", "B-200  Bolt M6  40", "C-310  Clamp 2in  5"])
