 import unittest
 
 from directory.db import connect, seed
-from directory.users import get_user_by_email, search_users
+from directory.users import get_user_by_email, search_users, set_role
 
 
 class UsersTest(unittest.TestCase):
     def setUp(self):
         self.conn = connect()
+        self.addCleanup(self.conn.close)
         seed(self.conn, [("Ana Lima", "ana@x.io", "admin"), ("Bruno", "bruno@x.io", "viewer")])
 
     def test_search(self):
@@ -15,6 +16,37 @@ class UsersTest(unittest.TestCase):
     def test_get_by_email(self):
         self.assertEqual(get_user_by_email(self.conn, "bruno@x.io")["role"], "viewer")
 
+    def test_lookup_injection_payloads(self):
+        for payload in ("' OR 1=1 --", "') OR 1=1 --", "'; DROP TABLE users; --"):
+            with self.subTest(payload=payload):
+                self.assertEqual(search_users(self.conn, payload), [])
+                self.assertIsNone(get_user_by_email(self.conn, payload))
+        self.assertEqual(len(search_users(self.conn, "")), 2)
+
+    def test_quoted_values_remain_searchable(self):
+        seed(self.conn, [("O'Neil", "o'neil@x.io", "viewer")])
+        self.assertEqual([u["name"] for u in search_users(self.conn, "O'NE")], ["O'Neil"])
+        self.assertEqual(get_user_by_email(self.conn, "o'neil@x.io")["name"], "O'Neil")
+
+    def test_search_literal_wildcards_and_escape(self):
+        seed(self.conn, [("100%_! done", "literal@x.io", "viewer")])
+        for fragment in ("%", "_", "!", "%_!", "100%_! DONE"):
+            with self.subTest(fragment=fragment):
+                self.assertEqual([u["name"] for u in search_users(self.conn, fragment)], ["100%_! done"])
+
+    def test_search_order_and_missing_email(self):
+        self.assertEqual([u["id"] for u in search_users(self.conn, "")], [1, 2])
+        self.assertIsNone(get_user_by_email(self.conn, "missing@x.io"))
+
+    def test_role_updates_are_constrained(self):
+        for role in ("viewer", "editor", "admin"):
+            set_role(self.conn, 2, role)
+            self.assertEqual(get_user_by_email(self.conn, "bruno@x.io")["role"], role)
+        with self.assertRaises(ValueError):
+            set_role(self.conn, 2, "admin'; DROP TABLE users; --")
+        set_role(self.conn, "1 OR 1=1", "editor")
+        self.assertEqual([u["role"] for u in search_users(self.conn, "")], ["admin", "admin"])
+
 
 if __name__ == "__main__":
     unittest.main()
