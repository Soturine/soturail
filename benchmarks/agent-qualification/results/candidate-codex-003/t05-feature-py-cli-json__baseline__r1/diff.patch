+import json
 import subprocess
 import sys
 import unittest
 
+from inventory.report import render_json
+
 
 class ReportTest(unittest.TestCase):
     def test_text_report(self):
         out = subprocess.run([sys.executable, "-m", "inventory", "report", "data/stock.csv"], capture_output=True, text=True, check=True).stdout
         self.assertEqual(out.splitlines(), ["A-100  Anchor  3 LOW", "B-200  Bolt M6  40", "C-310  Clamp 2in  5"])
 
+    def test_json_report(self):
+        for threshold in (5, 6):
+            with self.subTest(threshold=threshold):
+                result = subprocess.run(
+                    [sys.executable, "-m", "inventory", "report", "data/stock.csv",
+                     "--format", "json", "--threshold", str(threshold)],
+                    capture_output=True, text=True, check=True,
+                )
+                rows = json.loads(result.stdout)
+                self.assertEqual(rows, [
+                    {"sku": "A-100", "name": "Anchor", "quantity": 3, "low_stock": True},
+                    {"sku": "B-200", "name": "Bolt M6", "quantity": 40, "low_stock": False},
+                    {"sku": "C-310", "name": "Clamp 2in", "quantity": 5, "low_stock": threshold > 5},
+                ])
+                for row in rows:
+                    self.assertIs(type(row["quantity"]), int)
+                    self.assertIs(type(row["low_stock"]), bool)
+                self.assertEqual(result.stderr, "")
+
+    def test_empty_json_report(self):
+        self.assertEqual(json.loads(render_json([], 5)), [])
+
 
 if __name__ == "__main__":
     unittest.main()
