+    def test_injection_cannot_broaden_lookups(self):
+        for payload in ("' OR 1=1 --", "') OR 1=1 --", "' UNION SELECT 1, 'x', 'y', 'admin' --"):
+            with self.subTest(payload=payload):
+                self.assertEqual(search_users(self.conn, payload), [])
+                self.assertIsNone(get_user_by_email(self.conn, payload))
+
+    def test_quoted_values_are_data(self):
+        seed(self.conn, [("O'Brien", "o'brien@x.io", "editor")])
+        self.assertEqual([u["name"] for u in search_users(self.conn, "o'BR")], ["O'Brien"])
+        self.assertEqual(get_user_by_email(self.conn, "o'brien@x.io")["name"], "O'Brien")
+        self.assertIsNone(get_user_by_email(self.conn, "missing@x.io"))
+
+    def test_search_treats_pattern_characters_literally(self):
+        for fragment in ("%", "_", "!", "!%_", "\\"):
+            with self.subTest(fragment=fragment):
+                email = f"literal-{fragment}@x.io"
+                seed(self.conn, [(f"Literal {fragment}", email, "viewer")])
+                self.assertEqual([u["email"] for u in search_users(self.conn, fragment)], [email])
+
+    def test_empty_search_preserves_order(self):
+        self.assertEqual([u["id"] for u in search_users(self.conn, "")], [1, 2])
+
+    def test_role_update_is_scoped_and_validated(self):
+        set_role(self.conn, 2, "editor")
+        set_role(self.conn, "1 OR 1=1", "viewer")
+        with self.assertRaises(ValueError):
+            set_role(self.conn, 1, "admin'; DROP TABLE users; --")
+        self.assertEqual([u["role"] for u in search_users(self.conn, "")], ["admin", "editor"])
