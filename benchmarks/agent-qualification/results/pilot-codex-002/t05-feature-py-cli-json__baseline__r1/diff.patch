+import json
 import subprocess
 import sys
+import tempfile
 import unittest
+from pathlib import Path
 
 
 class ReportTest(unittest.TestCase):
+    def run_report(self, path, *args):
+        return subprocess.run(
+            [sys.executable, "-m", "inventory", "report", str(path), *args],
+            capture_output=True, text=True, check=True,
+        ).stdout
+
     def test_text_report(self):
         out = subprocess.run([sys.executable, "-m", "inventory", "report", "data/stock.csv"], capture_output=True, text=True, check=True).stdout
         self.assertEqual(out.splitlines(), ["A-100  Anchor  3 LOW", "B-200  Bolt M6  40", "C-310  Clamp 2in  5"])
 
+    def test_explicit_text_matches_default(self):
+        self.assertEqual(self.run_report("data/stock.csv", "--format", "text"),
+                         self.run_report("data/stock.csv"))
+
+    def test_json_report_sorted_with_types_and_threshold(self):
+        with tempfile.TemporaryDirectory() as directory:
+            path = Path(directory) / "stock.csv"
+            path.write_text('sku,name,quantity\nZ-2,"Bolt, large",8\nA-1,Anchor,3\nM-1,Clamp,5\n', encoding="utf-8")
+            for threshold in (5, 8):
+                with self.subTest(threshold=threshold):
+                    rows = json.loads(self.run_report(path, "--format", "json", "--threshold", str(threshold)))
+                    self.assertEqual(rows, [
+                        {"sku": "A-1", "name": "Anchor", "quantity": 3, "low_stock": True},
+                        {"sku": "M-1", "name": "Clamp", "quantity": 5, "low_stock": 5 < threshold},
+                        {"sku": "Z-2", "name": "Bolt, large", "quantity": 8, "low_stock": False},
+                    ])
+                    for row in rows:
+                        self.assertIs(type(row["quantity"]), int)
+                        self.assertIs(type(row["low_stock"]), bool)
+
+    def test_empty_json_report(self):
+        with tempfile.TemporaryDirectory() as directory:
+            path = Path(directory) / "empty.csv"
+            path.write_text("sku,name,quantity\n", encoding="utf-8")
+            self.assertEqual(json.loads(self.run_report(path, "--format", "json")), [])
+
 
 if __name__ == "__main__":
     unittest.main()
