diff --git a/test/limiter.test.js b/test/limiter.test.js
index e3eaf9d..b0c5259 100644
--- a/test/limiter.test.js
+++ b/test/limiter.test.js
@@ -15,3 +15,48 @@ test("blocks after limit within a window and resets next window", () => {
 test("validates options", () => {
   assert.throws(() => createLimiter({ limit: 0, windowMs: 10 }), RangeError);
 });
+
+test("uses per-key limits and reports remaining budget without consuming it", () => {
+  let t = 999;
+  const limiter = createLimiter({
+    limit: 2, windowMs: 1000, now: () => t, overrides: { low: 1, high: 3 }
+  });
+  for (const [key, budget] of [["low", 1], ["high", 3], ["default", 2], ["toString", 2]]) {
+    assert.equal(limiter.remaining(key), budget);
+    assert.equal(limiter.remaining(key), budget);
+    for (let used = 1; used <= budget; used++) {
+      assert.equal(limiter.tryAcquire(key), true);
+      assert.equal(limiter.remaining(key), budget - used);
+    }
+    assert.equal(limiter.tryAcquire(key), false);
+    assert.equal(limiter.remaining(key), 0);
+  }
+  t = 1000;
+  assert.equal(limiter.remaining("low"), 1);
+  assert.equal(limiter.remaining("high"), 3);
+  assert.equal(limiter.remaining("default"), 2);
+  assert.equal(limiter.tryAcquire("low"), true);
+  assert.equal(limiter.remaining("low"), 0);
+});
+
+test("accepts Map overrides and ignores inherited object properties", () => {
+  const key = {};
+  const limiter = createLimiter({ limit: 2, windowMs: 1000, overrides: new Map([[key, 1]]) });
+  assert.equal(limiter.remaining(key), 1);
+  assert.equal(limiter.tryAcquire(key), true);
+  assert.equal(limiter.tryAcquire(key), false);
+  assert.equal(limiter.remaining("other"), 2);
+  const inherited = createLimiter({ limit: 2, windowMs: 1000, overrides: Object.create({ a: 1 }) });
+  assert.equal(inherited.remaining("a"), 2);
+});
+
+test("validates override limits", () => {
+  for (const value of [0, -1, 1.5, NaN, Infinity, "2", undefined, null]) {
+    for (const overrides of [{ a: value }, new Map([["a", value]])]) {
+      assert.throws(() => createLimiter({ limit: 2, windowMs: 10, overrides }), RangeError);
+    }
+  }
+  for (const overrides of [null, [], "invalid", 3]) {
+    assert.throws(() => createLimiter({ limit: 2, windowMs: 10, overrides }), TypeError);
+  }
+});
