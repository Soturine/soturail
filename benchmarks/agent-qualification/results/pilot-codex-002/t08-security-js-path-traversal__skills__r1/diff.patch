 import test from "node:test";
 import assert from "node:assert/strict";
 import path from "node:path";
+import { promises as fs } from "node:fs";
+import os from "node:os";
 import { serveStatic } from "../src/static.js";
 
 const root = path.resolve("public");
@@ -14,3 +16,36 @@ test("serves a nested file", async () => {
 test("missing file is 404", async () => {
   assert.equal((await serveStatic(root, "/nope.txt")).status, 404);
 });
+
+test("contains decoded paths and symbolic links within the public root", async (t) => {
+  const fixture = await fs.mkdtemp(path.join(os.tmpdir(), "static-test-"));
+  t.after(() => fs.rm(fixture, { recursive: true, force: true }));
+  const publicRoot = path.join(fixture, "public");
+  const sibling = path.join(fixture, "public-extra");
+  await fs.mkdir(publicRoot);
+  await fs.mkdir(sibling);
+  await fs.writeFile(path.join(fixture, "outside.txt"), "outside fixture");
+  await fs.writeFile(path.join(sibling, "file.txt"), "sibling fixture");
+  await fs.writeFile(path.join(publicRoot, "notes..v2.txt"), "public fixture");
+
+  for (const request of [
+    "/../outside.txt", "/%2e%2e/outside.txt", "/..%2foutside.txt",
+    "/%2e%2e%5coutside.txt", "/..\\outside.txt", "/../public-extra/file.txt",
+    "/%", "/%GG", "/%00", "/%E0%A4%A",
+  ]) {
+    const result = await serveStatic(publicRoot, request);
+    assert.equal(result.status, 404, request);
+    assert.equal(result.body.toString(), "not found", request);
+  }
+  const valid = await serveStatic(publicRoot, "/notes..v2.txt?cache=1");
+  assert.equal(valid.status, 200);
+  assert.equal(valid.body.toString(), "public fixture");
+
+  // Directory junctions can be created without symlink privileges on Windows.
+  await fs.symlink(sibling, path.join(publicRoot, "escape"), process.platform === "win32" ? "junction" : "dir");
+  assert.equal((await serveStatic(publicRoot, "/escape/file.txt")).status, 404);
+  await fs.mkdir(path.join(publicRoot, "nested"));
