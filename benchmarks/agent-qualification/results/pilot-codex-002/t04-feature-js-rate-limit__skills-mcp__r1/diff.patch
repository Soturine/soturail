 test("validates options", () => {
   assert.throws(() => createLimiter({ limit: 0, windowMs: 10 }), RangeError);
 });
+
+test("overrides replace limits and remaining observes independent budgets", () => {
+  let t = 500;
+  const limiter = createLimiter({
+    limit: 2, windowMs: 1000, now: () => t, overrides: { low: 1, high: 3 }
+  });
+  for (const [key, budget] of [["low", 1], ["high", 3], ["default", 2], ["toString", 2]]) {
+    assert.equal(limiter.remaining(key), budget);
+    assert.equal(limiter.remaining(key), budget);
+    for (let count = 1; count <= budget; count++) {
+      assert.equal(limiter.tryAcquire(key), true);
+      assert.equal(limiter.remaining(key), budget - count);
+    }
+    assert.equal(limiter.tryAcquire(key), false);
+    assert.equal(limiter.remaining(key), 0);
+  }
+  t = 999;
+  assert.equal(limiter.remaining("high"), 0);
+  t = 1000;
+  assert.equal(limiter.remaining("high"), 3);
+  assert.equal(limiter.remaining("low"), 1);
+  assert.equal(limiter.remaining("default"), 2);
+  assert.equal(limiter.tryAcquire("high"), true);
+  assert.equal(limiter.remaining("high"), 2);
+});
+
+test("override limits must be positive integers", () => {
+  for (const value of [0, -1, 1.5, NaN, Infinity, "2", undefined]) {
+    assert.throws(() => createLimiter({
+      limit: 2, windowMs: 1000, overrides: { a: value }
+    }), RangeError);
+  }
+});
+
+test("only own override entries are copied at creation", () => {
+  const overrides = Object.assign(Object.create({ inherited: 1 }), { a: 3 });
+  const limiter = createLimiter({ limit: 2, windowMs: 1000, overrides });
+  overrides.a = 1;
+  assert.equal(limiter.remaining("a"), 3);
+  assert.equal(limiter.remaining("inherited"), 2);
+});
