-  const decoded = decodeURIComponent(requestPath.split("?")[0]);
-  const target = path.join(publicRoot, decoded);
   try {
-    const body = await fs.readFile(target);
+    const decoded = decodeURIComponent(requestPath.split("?")[0]);
+    // Treat both separator styles consistently, including on POSIX hosts.
+    const normalized = decoded.replaceAll("\\", "/");
+    const root = path.resolve(publicRoot);
+    const target = path.resolve(root, `.${normalized.startsWith("/") ? "" : "/"}${normalized}`);
+    if (decoded.includes("\0") || !isWithin(root, target)) throw new Error("invalid path");
+    // Lexical containment alone cannot detect a symlink pointing outside public.
+    const realRoot = await fs.realpath(root);
+    const realTarget = await fs.realpath(target);
+    if (!isWithin(realRoot, realTarget)) throw new Error("invalid path");
+    const body = await fs.readFile(realTarget);
     return { status: 200, type: TYPES[path.extname(target)] ?? "application/octet-stream", body };
   } catch {
     return { status: 404, type: "text/plain", body: Buffer.from("not found") };
