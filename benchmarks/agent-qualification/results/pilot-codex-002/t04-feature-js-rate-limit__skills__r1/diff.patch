@@ -4,12 +4,17 @@ Fixed-window rate limiter.
 
 ```js
 import { createLimiter } from "./src/limiter.js";
-const limiter = createLimiter({ limit: 100, windowMs: 60_000 });
+const limiter = createLimiter({ limit: 100, windowMs: 60_000, overrides: { "client-a": 200 } });
+limiter.remaining("client-a"); // 200
 limiter.tryAcquire("client-a"); // true while the key has budget in the current window
+limiter.remaining("client-a"); // 199
 ```
 
 Options:
 
 - `limit` (positive integer, required) — requests allowed per key per window.
 - `windowMs` (positive integer, required) — window length.
+- `overrides` (object, optional) — own key-to-limit entries replacing `limit` for those keys. Values must be positive integers. Defaults to `{}`; other keys use `limit`.
 - `now` (function, optional) — clock, defaults to `Date.now`. Windows start at multiples of `windowMs`.
+
+`remaining(key)` returns the requests still available in the current window without consuming a request. It returns zero once exhausted and resets to the key's limit at the next window boundary. Each key has an independent budget.
