@@ -2,13 +2,24 @@ function isPlainObject(value) {
   return value !== null && typeof value === "object" && !Array.isArray(value);
 }
 
+function cloneConfig(value) {
+  if (Array.isArray(value)) return value.map(cloneConfig);
+  if (isPlainObject(value)) return mergeConfig(value);
+  return value;
+}
+
 export function mergeConfig(base, override = {}) {
-  const result = { ...base };
+  // Each result owns its nested values, including branches without overrides.
+  const result = Object.fromEntries(
+    Object.entries(base).map(([key, value]) => [key, cloneConfig(value)])
+  );
   for (const [key, value] of Object.entries(override)) {
     if (isPlainObject(value) && isPlainObject(result[key])) {
-      result[key] = Object.assign(result[key], mergeConfig(result[key], value));
+      result[key] = mergeConfig(result[key], value);
     } else {
-      result[key] = value;
+      Object.defineProperty(result, key, {
+        value: cloneConfig(value), enumerable: true, writable: true, configurable: true
+      });
     }
   }
   return result;
diff --git a/test/merge.test.js b/test/merge.test.js
index db17da7..80592da 100644
--- a/test/merge.test.js
+++ b/test/merge.test.js
@@ -10,3 +10,33 @@ test("nested values are merged", () => {
   const merged = mergeConfig({ http: { timeoutMs: 1, keep: true } }, { http: { timeoutMs: 2 } });
   assert.deepEqual(merged, { http: { timeoutMs: 2, keep: true } });
 });
+
+test("merging does not mutate either input or share nested objects and arrays", () => {
+  const base = { http: { timeoutMs: 5000, retry: { attempts: 2 } }, regions: ["eu"], extra: { enabled: true } };
+  const override = { http: { retry: { attempts: 5 } }, headers: { tags: ["tenant"] } };
+  const originalBase = structuredClone(base);
+  const originalOverride = structuredClone(override);
+  const merged = mergeConfig(base, override);
+  assert.deepEqual(base, originalBase);
+  assert.deepEqual(override, originalOverride);
+  merged.http.retry.attempts = 99;
+  merged.regions.push("us");
+  merged.extra.enabled = false;
+  merged.headers.tags.push("changed");
+  assert.deepEqual(base, originalBase);
+  assert.deepEqual(override, originalOverride);
+});
+
+test("arrays replace defaults and their nested elements are isolated", () => {
+  const base = { values: [{ n: 1 }] };
+  const override = { values: [{ n: 2 }] };
+  const merged = mergeConfig(base, override);
+  assert.deepEqual(merged.values, [{ n: 2 }]);
+  merged.values[0].n = 3;
+  assert.equal(override.values[0].n, 2);
+  assert.equal(base.values[0].n, 1);
+});
+
+test("null and scalar values replace nested objects", () => {
+  assert.deepEqual(mergeConfig({ a: { b: 1 }, c: 1 }, { a: null, c: { d: 2 } }), { a: null, c: { d: 2 } });
+});
