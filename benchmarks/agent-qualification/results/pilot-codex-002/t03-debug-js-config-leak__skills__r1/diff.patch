 import test from "node:test";
 import assert from "node:assert/strict";
 import { mergeConfig } from "../src/merge.js";
+import { configFor } from "../src/tenants.js";
+import { DEFAULTS } from "../src/defaults.js";
 
 test("override wins for scalars", () => {
   assert.equal(mergeConfig({ a: 1 }, { a: 2 }).a, 2);
 });
 
+test("nested merges leave both inputs unchanged", () => {
+  const base = Object.freeze({
+    http: Object.freeze({ timeoutMs: 5000, retry: Object.freeze({ attempts: 2, backoffMs: 100 }) })
+  });
+  const override = Object.freeze({
+    http: Object.freeze({ timeoutMs: 30000, retry: Object.freeze({ attempts: 5 }) })
+  });
+  assert.deepEqual(mergeConfig(base, override), {
+    http: { timeoutMs: 30000, retry: { attempts: 5, backoffMs: 100 } }
+  });
+});
+
+test("arrays and scalars replace base values", () => {
+  const base = { regions: ["eu", "us"], http: { timeoutMs: 5000 } };
+  const override = { regions: ["ap"], http: null };
+  assert.deepEqual(mergeConfig(base, override), override);
+  assert.deepEqual(base, { regions: ["eu", "us"], http: { timeoutMs: 5000 } });
+});
+
+test("tenant settings remain isolated across repeated request orders", () => {
+  const defaults = structuredClone(DEFAULTS);
+  for (const tenant of ["initech", "globex", "acme", "globex", "initech", "unknown", "acme", "initech"]) {
+    const config = configFor(tenant);
+    assert.deepEqual(config.http, tenant === "acme"
+      ? { timeoutMs: 30000, retry: { attempts: 5, backoffMs: 100 } }
+      : { timeoutMs: 5000, retry: { attempts: 2, backoffMs: 100 } });
+    assert.deepEqual(config.headers, tenant === "globex"
+      ? { "user-agent": "tenant-gateway/2", "x-tenant": "globex" }
+      : { "user-agent": "tenant-gateway/2" });
+    assert.deepEqual(DEFAULTS, defaults);
+  }
+});
+
