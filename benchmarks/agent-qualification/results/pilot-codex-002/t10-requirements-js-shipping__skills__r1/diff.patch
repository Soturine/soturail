diff --git a/src/shipping.js b/src/shipping.js
index 29c8394..20322c9 100644
--- a/src/shipping.js
+++ b/src/shipping.js
@@ -1,3 +1,16 @@
 export function shippingFee({ subtotal, country, weightKg, express = false }) {
-  throw new Error("not implemented");
+  if (typeof weightKg !== "number" || Number.isNaN(weightKg) || weightKg < 0) {
+    throw new RangeError("weightKg must be a non-negative number");
+  }
+
+  const domestic = country === "ES";
+  if (domestic && subtotal >= 50) {
+    if (express) {
+      throw new Error("Unresolved shipping requirement R4: see OPEN_QUESTIONS.md");
+    }
+    return 0;
+  }
+
+  const base = domestic ? 490 : 1200 + Math.max(0, Math.floor(weightKg - 2)) * 150;
+  return (base + (express ? 600 : 0)) / 100;
 }
diff --git a/test/shipping.test.js b/test/shipping.test.js
index 1dca596..97f830d 100644
--- a/test/shipping.test.js
+++ b/test/shipping.test.js
@@ -5,3 +5,39 @@ import { shippingFee } from "../src/shipping.js";
 test("module exports shippingFee", () => {
   assert.equal(typeof shippingFee, "function");
 });
+
+test("domestic base, free threshold and express surcharge", () => {
+  for (const [subtotal, express, expected] of [
+    [0, false, 4.9], [49.99, false, 4.9], [50, false, 0],
+    [60, false, 0], [49.99, true, 10.9],
+  ]) {
+    assert.equal(shippingFee({ subtotal, country: "ES", weightKg: 1, express }), expected);
+  }
+  assert.equal(shippingFee({ subtotal: 10, country: "ES", weightKg: 0 }), 4.9);
+});
+
+test("international charges only complete kilograms above two", () => {
+  for (const country of ["FR", "US", "es"]) {
+    for (const [weightKg, expected] of [[0, 12], [2, 12], [2.99, 12], [3, 13.5], [4.7, 15]]) {
+      assert.equal(shippingFee({ subtotal: 60, country, weightKg }), expected);
+      assert.equal(shippingFee({ subtotal: 60, country, weightKg, express: true }), expected + 6);
+    }
+  }
+});
+
+test("invalid weights throw RangeError before pricing", () => {
+  for (const weightKg of [-1, NaN, "2", null, undefined, {}, true]) {
+    for (const country of ["ES", "FR"]) {
+      assert.throws(() => shippingFee({ subtotal: 60, country, weightKg, express: true }), RangeError);
+    }
+  }
+});
+
+test("contradictory free domestic express case stays explicitly unresolved", () => {
+  for (const subtotal of [50, 60, 100]) {
+    assert.throws(
+      () => shippingFee({ subtotal, country: "ES", weightKg: 1, express: true }),
+      /Unresolved shipping requirement R4: see OPEN_QUESTIONS.md/,
+    );
+  }
+});
