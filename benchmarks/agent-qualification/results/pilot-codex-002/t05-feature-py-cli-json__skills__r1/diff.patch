+import json
+from pathlib import Path
 import subprocess
 import sys
+import tempfile
 import unittest
 
 
@@ -8,6 +11,38 @@ class ReportTest(unittest.TestCase):
         out = subprocess.run([sys.executable, "-m", "inventory", "report", "data/stock.csv"], capture_output=True, text=True, check=True).stdout
         self.assertEqual(out.splitlines(), ["A-100  Anchor  3 LOW", "B-200  Bolt M6  40", "C-310  Clamp 2in  5"])
 
+    def test_json_report(self):
+        with tempfile.TemporaryDirectory() as directory:
+            path = Path(directory) / "stock.csv"
+            path.write_text('sku,name,quantity\nZ-2,"Bolt, large",6\nA-1,Anchor,0\nM-3,Clamp,5\n', encoding="utf-8")
+            for threshold in (5, 6):
+                with self.subTest(threshold=threshold):
+                    result = subprocess.run(
+                        [sys.executable, "-m", "inventory", "report", str(path),
+                         "--format", "json", "--threshold", str(threshold)],
+                        capture_output=True, text=True, check=True,
+                    )
+                    records = json.loads(result.stdout)
+                    self.assertEqual(records, [
+                        {"sku": "A-1", "name": "Anchor", "quantity": 0, "low_stock": True},
+                        {"sku": "M-3", "name": "Clamp", "quantity": 5, "low_stock": 5 < threshold},
+                        {"sku": "Z-2", "name": "Bolt, large", "quantity": 6, "low_stock": False},
+                    ])
+                    for record in records:
+                        self.assertIs(type(record["quantity"]), int)
+                        self.assertIs(type(record["low_stock"]), bool)
+                    self.assertEqual(result.stderr, "")
