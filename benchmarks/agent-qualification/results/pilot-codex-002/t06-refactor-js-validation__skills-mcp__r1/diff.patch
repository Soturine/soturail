--- a/src/handlers/update-user.js
+++ b/src/handlers/update-user.js
@@ -1,21 +1,19 @@
+import { validateEmail, validateName, validateAge } from "../validation.js";
+
 export function updateUser(store, id, patch) {
   const current = store.get(id);
   if (!current) return { status: 404, errors: ["user: not found"] };
   const errors = [];
   const next = { ...current };
   if (patch.email !== undefined) {
-    const email = typeof patch.email === "string" ? patch.email.trim().toLowerCase() : "";
-    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) errors.push("email: invalid");
+    const email = validateEmail(patch, errors);
     next.email = email;
   }
   if (patch.name !== undefined) {
-    const name = typeof patch.name === "string" ? patch.name.trim() : "";
-    if (name.length < 2 || name.length > 80) errors.push("name: must be 2-80 characters");
+    const name = validateName(patch, errors);
     next.name = name;
   }
-  if (patch.age !== undefined && (!Number.isInteger(patch.age) || patch.age < 13 || patch.age > 130)) {
-    errors.push("age: must be an integer between 13 and 130");
-  }
+  validateAge(patch, errors);
   if (patch.age !== undefined) next.age = patch.age;
   if (errors.length) return { status: 422, errors };
   return { status: 200, user: store.replace(id, next) };
diff --git a/test/handlers.test.js b/test/handlers.test.js
index 0bea9d7..ed4a187 100644
--- a/test/handlers.test.js
+++ b/test/handlers.test.js
@@ -16,3 +16,52 @@ test("update rejects invalid age", () => {
   createUser(store, { email: "a@b.co", name: "Ana" });
   assert.equal(updateUser(store, 1, { age: 7 }).status, 422);
 });
+
+test("both handlers preserve validation errors and reject without writing", () => {
+  for (const input of [
+    { email: null, name: 5, age: null },
+    { email: "bad", name: " A ", age: 12 },
+    { email: "a@b.co", name: "x".repeat(81), age: 131 },
+    { email: "a@b.co", name: "Ana", age: 13.5 },
+  ]) {
+    const store = createStore();
+    const original = createUser(store, { email: "a@b.co", name: "Ana" }).user;
+    const created = createUser(store, input);
+    assert.equal(created.status, 422);
+    assert.deepEqual(updateUser(store, original.id, input), created);
+    assert.deepEqual(store.get(original.id), original);
+  }
+  assert.deepEqual(createUser(createStore(), {}), {
+    status: 422,
+    errors: ["email: invalid", "name: must be 2-80 characters"],
+  });
+  assert.deepEqual(createUser(createStore(), { age: null }).errors, [
+    "email: invalid", "name: must be 2-80 characters",
+    "age: must be an integer between 13 and 130",
+  ]);
+});
+
+test("partial updates preserve omitted fields and normalize supplied fields", () => {
+  const store = createStore();
+  const original = createUser(store, { email: "a@b.co", name: "Ana", age: 13 }).user;
+  assert.deepEqual(updateUser(store, original.id, { email: undefined, name: undefined, age: undefined }), {
+    status: 200, user: original,
+  });
+  assert.deepEqual(updateUser(store, original.id, { email: " B@Example.COM ", name: " Bo ", age: 130 }), {
+    status: 200, user: { id: original.id, email: "b@example.com", name: "Bo", age: 130 },
+  });
+  assert.deepEqual(updateUser(store, 999, null), { status: 404, errors: ["user: not found"] });
+});
+
+test("both handlers accept name and age boundaries", () => {
+  for (const name of ["Bo", "x".repeat(80)]) {
+    for (const age of [undefined, 13, 130]) {
+      const store = createStore();
+      const input = { email: "a@b.co", name, ...(age !== undefined ? { age } : {}) };
+      const created = createUser(store, input);
+      assert.equal(created.status, 201);
+      assert.deepEqual(created.user, { id: 1, ...input });
+      assert.deepEqual(updateUser(store, 1, input), { status: 200, user: created.user });
+    }
+  }
+});
