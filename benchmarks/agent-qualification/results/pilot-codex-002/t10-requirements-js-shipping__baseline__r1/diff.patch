diff --git a/src/shipping.js b/src/shipping.js
index 29c8394..c23fc46 100644
--- a/src/shipping.js
+++ b/src/shipping.js
@@ -1,3 +1,17 @@
 export function shippingFee({ subtotal, country, weightKg, express = false }) {
-  throw new Error("not implemented");
+  if (typeof weightKg !== "number" || Number.isNaN(weightKg) || weightKg < 0) {
+    throw new RangeError("weightKg must be a non-negative number");
+  }
+
+  const domestic = country === "ES";
+  if (domestic && subtotal >= 50 && express) {
+    // R2 and R4 conflict; see OPEN_QUESTIONS.md before resolving this case.
+    throw new Error("Unresolved shipping requirements: domestic express orders with subtotal >= 50 (R2/R4)");
+  }
+
+  const baseFee = domestic
+    ? (subtotal >= 50 ? 0 : 4.9)
+    : 12 + 1.5 * Math.max(0, Math.floor(weightKg - 2));
+
+  return Number((baseFee + (express ? 6 : 0)).toFixed(2));
 }
diff --git a/test/shipping.test.js b/test/shipping.test.js
index 1dca596..dd4cf1b 100644
--- a/test/shipping.test.js
+++ b/test/shipping.test.js
@@ -5,3 +5,36 @@ import { shippingFee } from "../src/shipping.js";
 test("module exports shippingFee", () => {
   assert.equal(typeof shippingFee, "function");
 });
+
+test("national standard shipping becomes free at 50 euros", () => {
+  for (const [subtotal, expected] of [[0, 4.9], [49.99, 4.9], [50, 0], [60, 0]]) {
+    assert.equal(shippingFee({ subtotal, country: "ES", weightKg: 3 }), expected);
+  }
+});
+
+test("international shipping charges only complete kilograms above two", () => {
+  for (const country of ["FR", "US"]) {
+    for (const [weightKg, expected] of [[0, 12], [2, 12], [2.99, 12], [3, 13.5], [4.7, 15]]) {
+      assert.equal(shippingFee({ subtotal: 60, country, weightKg }), expected);
+    }
+  }
+});
+
+test("express adds six euros in unambiguous cases", () => {
+  assert.equal(shippingFee({ subtotal: 49.99, country: "ES", weightKg: 1, express: true }), 10.9);
+  assert.equal(shippingFee({ subtotal: 60, country: "FR", weightKg: 4.7, express: true }), 21);
+});
+
+test("conflicting domestic express cases remain explicitly unresolved", () => {
+  for (const subtotal of [50, 60, 100]) {
+    assert.throws(() => shippingFee({ subtotal, country: "ES", weightKg: 1, express: true }), /Unresolved shipping requirements/);
+  }
+});
+
+test("invalid weights throw RangeError before any fee decision", () => {
+  for (const weightKg of [-1, NaN, "2", null, undefined, {}, true]) {
+    for (const country of ["ES", "FR"]) {
+      assert.throws(() => shippingFee({ subtotal: 60, country, weightKg, express: true }), RangeError);
+    }
+  }
+});
