diff --git a/src/shipping.js b/src/shipping.js
index 29c8394..7e83725 100644
--- a/src/shipping.js
+++ b/src/shipping.js
@@ -1,3 +1,15 @@
 export function shippingFee({ subtotal, country, weightKg, express = false }) {
-  throw new Error("not implemented");
+  if (!Number.isFinite(weightKg) || weightKg < 0) {
+    throw new RangeError("weightKg must be a finite non-negative number");
+  }
+
+  const domestic = country === "ES";
+  if (domestic && subtotal >= 50 && express) {
+    throw new Error("Unresolved shipping requirement R4: see OPEN_QUESTIONS.md");
+  }
+
+  const baseFee = domestic
+    ? (subtotal >= 50 ? 0 : 490)
+    : 1200 + Math.floor(Math.max(0, weightKg - 2)) * 150;
+  return (baseFee + (express ? 600 : 0)) / 100;
 }
diff --git a/test/shipping.test.js b/test/shipping.test.js
index 1dca596..00bd9ef 100644
--- a/test/shipping.test.js
+++ b/test/shipping.test.js
@@ -5,3 +5,40 @@ import { shippingFee } from "../src/shipping.js";
 test("module exports shippingFee", () => {
   assert.equal(typeof shippingFee, "function");
 });
+
+test("national fees and free shipping threshold", () => {
+  for (const [subtotal, expected] of [[0, 4.9], [49.99, 4.9], [50, 0], [60, 0]]) {
+    assert.equal(shippingFee({ subtotal, country: "ES", weightKg: 4.7 }), expected);
+  }
+});
+
+test("international fees count only complete kilograms above two", () => {
+  for (const country of ["FR", "US"]) {
+    for (const [weightKg, expected] of [[0, 12], [2, 12], [2.99, 12], [3, 13.5], [4.7, 15], [5, 16.5]]) {
+      assert.equal(shippingFee({ subtotal: 60, country, weightKg }), expected);
+    }
+  }
+});
+
+test("unambiguous express orders add six euros", () => {
+  assert.equal(shippingFee({ subtotal: 49.99, country: "ES", weightKg: 1, express: true }), 10.9);
+  assert.equal(shippingFee({ subtotal: 60, country: "FR", weightKg: 4.7, express: true }), 21);
+});
+
+test("contradictory national express cases explicitly remain unresolved", () => {
+  for (const subtotal of [50, 60, 100]) {
+    assert.throws(() => shippingFee({ subtotal, country: "ES", weightKg: 1, express: true }), /Unresolved shipping requirement R4/);
+  }
+});
+
+test("invalid weights raise RangeError before fee calculation", () => {
+  for (const weightKg of [-1, NaN, Infinity, -Infinity, "2", null, undefined, {}, true]) {
+    for (const options of [
+      { subtotal: 10, country: "FR" },
+      { subtotal: 60, country: "ES" },
+      { subtotal: 60, country: "ES", express: true },
+    ]) {
+      assert.throws(() => shippingFee({ ...options, weightKg }), RangeError);
+    }
+  }
+});
