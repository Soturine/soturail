diff --git a/test/handlers.test.js b/test/handlers.test.js
index 0bea9d7..d61bac4 100644
--- a/test/handlers.test.js
+++ b/test/handlers.test.js
@@ -16,3 +16,43 @@ test("update rejects invalid age", () => {
   createUser(store, { email: "a@b.co", name: "Ana" });
   assert.equal(updateUser(store, 1, { age: 7 }).status, 422);
 });
+
+test("both handlers preserve validation errors and leave the store unchanged", () => {
+  for (const invalid of [
+    { email: null }, { email: "a@b" }, { name: " A " }, { name: "a".repeat(81) },
+    { name: 42 }, ...[null, "13", 12, 131, 13.5, NaN].map(age => ({ age })),
+    { email: "bad", name: "", age: 0 },
+  ]) {
+    const store = createStore();
+    const input = { email: "a@b.co", name: "Ana", age: 30 };
+    const original = createUser(store, input).user;
+    const created = createUser(store, { ...input, ...invalid });
+    const updated = updateUser(store, 1, invalid);
+    assert.equal(created.status, 422);
+    assert.deepEqual(updated, created);
+    assert.deepEqual(store.get(1), original);
+    assert.equal(store.get(2), undefined);
+  }
+});
+
+test("validation boundaries, partial updates and missing users stay consistent", () => {
+  for (const age of [undefined, 13, 130]) {
+    for (const name of ["Ab", "a".repeat(80)]) {
+      const store = createStore();
+      const created = createUser(store, { email: " A@B.CO ", name: ` ${name} `, age });
+      assert.equal(created.status, 201);
+      const expected = { id: 1, email: "a@b.co", name, ...(age !== undefined ? { age } : {}) };
+      assert.deepEqual(created.user, expected);
+      assert.deepEqual(updateUser(store, 1, { email: undefined, name: undefined, age: undefined }),
+        { status: 200, user: expected });
+      assert.deepEqual(updateUser(store, 1, { email: " X@Y.CO ", name: " Bo ", age: 13 }),
+        { status: 200, user: { id: 1, email: "x@y.co", name: "Bo", age: 13 } });
+    }
+  }
+  assert.deepEqual(createUser(createStore(), {}), {
+    status: 422, errors: ["email: invalid", "name: must be 2-80 characters"],
+  });
+  assert.deepEqual(updateUser(createStore(), 99, null), {
+    status: 404, errors: ["user: not found"],
+  });
+});
