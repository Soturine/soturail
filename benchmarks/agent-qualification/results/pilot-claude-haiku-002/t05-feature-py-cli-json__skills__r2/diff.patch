+def render_json(items, threshold):
+    rows = [
+        {
+            "sku": item["sku"],
+            "name": item["name"],
+            "quantity": item["quantity"],
+            "low_stock": item["quantity"] < threshold,
+        }
+        for item in sorted(items, key=lambda entry: entry["sku"])
+    ]
+    return json.dumps(rows, indent=2)
