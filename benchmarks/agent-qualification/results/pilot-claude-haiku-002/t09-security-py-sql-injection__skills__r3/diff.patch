+    def test_search_is_case_insensitive(self):
+        self.assertEqual([u["name"] for u in search_users(self.conn, "ANA")], ["Ana Lima"])
+
+    def test_search_injection_payload_is_inert(self):
+        self.assertEqual(search_users(self.conn, "' OR '1'='1"), [])
+        self.assertEqual(search_users(self.conn, "x'; DROP TABLE users; --"), [])
+        self.assertEqual(len(search_users(self.conn, "Ana")), 1)
+
+    def test_search_treats_like_wildcards_literally(self):
+        self.assertEqual(search_users(self.conn, "%"), [])
+        self.assertEqual(search_users(self.conn, "_"), [])
+        self.assertEqual(search_users(self.conn, "\\"), [])
+
+    def test_get_by_email_injection_payload_is_inert(self):
+        self.assertIsNone(get_user_by_email(self.conn, "' OR '1'='1"))
+        self.assertIsNone(get_user_by_email(self.conn, "x' OR 1=1 --"))
+        self.assertEqual(len(search_users(self.conn, "")), 2)
+
 
 if __name__ == "__main__":
     unittest.main()
