+    def test_quoted_field_with_comma(self):
+        rows = parse_customers('nome,endereco,cidade\nAna,"Rua A, 10",Recife\n')
+        self.assertEqual(rows, [{"nome": "Ana", "endereco": "Rua A, 10", "cidade": "Recife"}])
+
+    def test_quoted_field_with_escaped_quote(self):
+        rows = parse_customers('nome,apelido\nAna,"A ""Aninha"""\n')
+        self.assertEqual(rows, [{"nome": "Ana", "apelido": 'A "Aninha"'}])
+
+    def test_blank_lines_ignored(self):
+        rows = parse_customers("nome,cidade\n\nAna,Recife\n\n")
