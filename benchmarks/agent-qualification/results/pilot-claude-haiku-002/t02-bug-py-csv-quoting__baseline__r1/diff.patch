@@ -1,9 +1,24 @@
 """Leitura de CSV de clientes exportado pelo ERP."""
 
 
+def split_fields(line):
+    # Divide nas vírgulas que estão fora de aspas; "" dentro de aspas alterna o estado duas vezes e continua correto.
+    raws = []
+    in_quotes = False
+    start = 0
+    for index, char in enumerate(line):
+        if char == '"':
+            in_quotes = not in_quotes
+        elif char == "," and not in_quotes:
+            raws.append(line[start:index])
+            start = index + 1
+    raws.append(line[start:])
+    return raws
+
+
 def split_line(line):
     fields = []
-    for raw in line.split(","):
+    for raw in split_fields(line):
         value = raw.strip()
         if len(value) >= 2 and value[0] == '"' and value[-1] == '"':
             value = value[1:-1].replace('""', '"')
