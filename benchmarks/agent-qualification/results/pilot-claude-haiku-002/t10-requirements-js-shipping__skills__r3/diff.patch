diff --git a/src/shipping.js b/src/shipping.js
index 29c8394..ba797ce 100644
--- a/src/shipping.js
+++ b/src/shipping.js
@@ -1,3 +1,26 @@
 export function shippingFee({ subtotal, country, weightKg, express = false }) {
-  throw new Error("not implemented");
+  if (typeof weightKg !== "number" || Number.isNaN(weightKg) || weightKg < 0) {
+    throw new RangeError("weightKg debe ser un número no negativo");
+  }
+
+  // Conflicto R2 vs R4 sin resolver: ver OPEN_QUESTIONS.md (Q1).
+  if (express && country === "ES" && subtotal >= 50) {
+    throw new Error("Caso sin resolver: envío exprés nacional con subtotal >= 50 (ver OPEN_QUESTIONS.md Q1)");
+  }
+
+  let fee;
+  if (country === "ES") {
+    // R1 + R2
+    fee = subtotal >= 50 ? 0 : 4.9;
+  } else {
+    // R3: 12 € base + 1,50 € por cada kg completo por encima de 2 kg
+    fee = 12 + Math.max(0, Math.floor(weightKg - 2)) * 1.5;
+  }
+
+  // R4
+  if (express) {
+    fee += 6;
+  }
+
+  return Math.round(fee * 100) / 100;
 }
diff --git a/test/shipping.test.js b/test/shipping.test.js
index 1dca596..a82ab33 100644
--- a/test/shipping.test.js
+++ b/test/shipping.test.js
@@ -5,3 +5,38 @@ import { shippingFee } from "../src/shipping.js";
 test("module exports shippingFee", () => {
   assert.equal(typeof shippingFee, "function");
 });
+
+test("R1: national base fee is 4.90", () => {
+  assert.equal(shippingFee({ subtotal: 20, country: "ES", weightKg: 1 }), 4.9);
+});
+
+test("R2: national orders with subtotal >= 50 ship free", () => {
+  assert.equal(shippingFee({ subtotal: 50, country: "ES", weightKg: 1 }), 0);
+  assert.equal(shippingFee({ subtotal: 49.99, country: "ES", weightKg: 1 }), 4.9);
+});
+
+test("R3: international base is 12.00 plus 1.50 per full kg above 2 kg", () => {
+  assert.equal(shippingFee({ subtotal: 20, country: "FR", weightKg: 1 }), 12);
+  assert.equal(shippingFee({ subtotal: 20, country: "FR", weightKg: 2 }), 12);
+  assert.equal(shippingFee({ subtotal: 20, country: "FR", weightKg: 4.7 }), 15);
+  assert.equal(shippingFee({ subtotal: 20, country: "FR", weightKg: 5 }), 16.5);
+});
+
+test("R3: international orders are not free at high subtotal", () => {
+  assert.equal(shippingFee({ subtotal: 200, country: "FR", weightKg: 1 }), 12);
+});
+
+test("R4: express adds 6.00 and is never free for international orders", () => {
+  assert.equal(shippingFee({ subtotal: 20, country: "FR", weightKg: 1, express: true }), 18);
+  assert.equal(shippingFee({ subtotal: 20, country: "ES", weightKg: 1, express: true }), 10.9);
+});
+
+test("R5: negative or non-numeric weight throws RangeError", () => {
+  assert.throws(() => shippingFee({ subtotal: 20, country: "ES", weightKg: -1 }), RangeError);
+  assert.throws(() => shippingFee({ subtotal: 20, country: "ES", weightKg: "2" }), RangeError);
+  assert.throws(() => shippingFee({ subtotal: 20, country: "ES", weightKg: NaN }), RangeError);
+});
+
+test("Q1: national express with subtotal >= 50 is explicitly unresolved", () => {
+  assert.throws(() => shippingFee({ subtotal: 60, country: "ES", weightKg: 1, express: true }), /sin resolver/);
+});
