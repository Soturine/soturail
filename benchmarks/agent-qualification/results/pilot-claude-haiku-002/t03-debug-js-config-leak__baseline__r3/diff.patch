diff --git a/src/merge.js b/src/merge.js
index 1b07886..a647fe0 100644
--- a/src/merge.js
+++ b/src/merge.js
@@ -2,13 +2,23 @@ function isPlainObject(value) {
   return value !== null && typeof value === "object" && !Array.isArray(value);
 }
 
+function clone(value) {
+  if (Array.isArray(value)) return value.map(clone);
+  if (!isPlainObject(value)) return value;
+  const copy = {};
+  for (const [key, inner] of Object.entries(value)) {
+    copy[key] = clone(inner);
+  }
+  return copy;
+}
+
 export function mergeConfig(base, override = {}) {
-  const result = { ...base };
+  const result = clone(base);
   for (const [key, value] of Object.entries(override)) {
     if (isPlainObject(value) && isPlainObject(result[key])) {
-      result[key] = Object.assign(result[key], mergeConfig(result[key], value));
+      result[key] = mergeConfig(result[key], value);
     } else {
-      result[key] = value;
+      result[key] = clone(value);
     }
   }
   return result;
diff --git a/test/merge.test.js b/test/merge.test.js
index db17da7..fa67f20 100644
--- a/test/merge.test.js
+++ b/test/merge.test.js
@@ -10,3 +10,18 @@ test("nested values are merged", () => {
   const merged = mergeConfig({ http: { timeoutMs: 1, keep: true } }, { http: { timeoutMs: 2 } });
   assert.deepEqual(merged, { http: { timeoutMs: 2, keep: true } });
 });
+
+test("inputs are not modified by a nested merge", () => {
+  const base = { http: { timeoutMs: 1, retry: { attempts: 2 } } };
+  const override = { http: { retry: { attempts: 5 } } };
+  mergeConfig(base, override);
+  assert.deepEqual(base, { http: { timeoutMs: 1, retry: { attempts: 2 } } });
+  assert.deepEqual(override, { http: { retry: { attempts: 5 } } });
+});
+
+test("result does not share nested objects with base", () => {
+  const base = { http: { retry: { attempts: 2 } } };
+  const merged = mergeConfig(base, {});
+  merged.http.retry.attempts = 9;
+  assert.equal(base.http.retry.attempts, 2);
+});
