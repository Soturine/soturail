diff --git a/src/static.js b/src/static.js
index f2f38b9..578c87f 100644
--- a/src/static.js
+++ b/src/static.js
@@ -3,14 +3,26 @@ import path from "node:path";
 
 const TYPES = { ".html": "text/html", ".css": "text/css", ".txt": "text/plain" };
 
+const NOT_FOUND = { status: 404, type: "text/plain", body: Buffer.from("not found") };
+
 // Resolves a request path such as "/css/site.css" against the public root.
+// Anything that resolves outside publicRoot (e.g. "/../secret.env") is a 404.
 export async function serveStatic(publicRoot, requestPath) {
-  const decoded = decodeURIComponent(requestPath.split("?")[0]);
-  const target = path.join(publicRoot, decoded);
+  let decoded;
+  try {
+    decoded = decodeURIComponent(requestPath.split("?")[0]);
+  } catch {
+    return NOT_FOUND;
+  }
+  const root = path.resolve(publicRoot);
+  const target = path.resolve(root, "." + path.sep + decoded);
+  if (!target.startsWith(root + path.sep)) {
+    return NOT_FOUND;
+  }
   try {
     const body = await fs.readFile(target);
     return { status: 200, type: TYPES[path.extname(target)] ?? "application/octet-stream", body };
   } catch {
-    return { status: 404, type: "text/plain", body: Buffer.from("not found") };
+    return NOT_FOUND;
   }
 }
diff --git a/test/static.test.js b/test/static.test.js
index b9d6e6e..92ce768 100644
--- a/test/static.test.js
+++ b/test/static.test.js
@@ -14,3 +14,15 @@ test("serves a nested file", async () => {
 test("missing file is 404", async () => {
   assert.equal((await serveStatic(root, "/nope.txt")).status, 404);
 });
+
+test("does not serve files outside the public root", async () => {
+  assert.equal((await serveStatic(root, "/../secret.env")).status, 404);
+  assert.equal((await serveStatic(root, "/css/../../secret.env")).status, 404);
+  assert.equal((await serveStatic(root, "/%2e%2e/secret.env")).status, 404);
+  assert.equal((await serveStatic(root, "/%2e%2e%2fsecret.env")).status, 404);
+  assert.equal((await serveStatic(root, "/..%5csecret.env")).status, 404);
+});
+
+test("malformed percent-encoding is 404 instead of throwing", async () => {
+  assert.equal((await serveStatic(root, "/%E0%A4%A")).status, 404);
+});
