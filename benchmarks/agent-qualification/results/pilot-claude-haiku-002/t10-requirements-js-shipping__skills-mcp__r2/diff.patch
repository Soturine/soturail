diff --git a/src/shipping.js b/src/shipping.js
index 29c8394..1106323 100644
--- a/src/shipping.js
+++ b/src/shipping.js
@@ -1,3 +1,32 @@
+const NATIONAL_BASE_FEE = 4.9;
+const FREE_SHIPPING_MIN_SUBTOTAL = 50;
+const INTERNATIONAL_BASE_FEE = 12;
+const INTERNATIONAL_INCLUDED_KG = 2;
+const INTERNATIONAL_FEE_PER_KG = 1.5;
+const EXPRESS_FEE = 6;
+
+const round2 = (amount) => Math.round(amount * 100) / 100;
+
 export function shippingFee({ subtotal, country, weightKg, express = false }) {
-  throw new Error("not implemented");
+  // R5: peso inválido o negativo
+  if (typeof weightKg !== "number" || !Number.isFinite(weightKg) || weightKg < 0) {
+    throw new RangeError("weightKg debe ser un número finito y no negativo");
+  }
+
+  if (country === "ES") {
+    // Conflicto R2/R4 (exprés nacional con subtotal >= 50): sin resolver, ver OPEN_QUESTIONS.md
+    if (express && subtotal >= FREE_SHIPPING_MIN_SUBTOTAL) {
+      throw new Error("Caso sin resolver: envío exprés nacional con subtotal >= 50 (ver OPEN_QUESTIONS.md)");
+    }
+    // R1, R2
+    const base = subtotal >= FREE_SHIPPING_MIN_SUBTOTAL ? 0 : NATIONAL_BASE_FEE;
+    // R4
+    return round2(base + (express ? EXPRESS_FEE : 0));
+  }
+
+  // R3: internacional, 1,50 € por cada kg completo por encima de 2 kg
+  const extraKg = Math.max(0, Math.floor(weightKg) - INTERNATIONAL_INCLUDED_KG);
+  const base = INTERNATIONAL_BASE_FEE + extraKg * INTERNATIONAL_FEE_PER_KG;
+  // R4
+  return round2(base + (express ? EXPRESS_FEE : 0));
 }
diff --git a/test/shipping.test.js b/test/shipping.test.js
index 1dca596..2cfd602 100644
--- a/test/shipping.test.js
+++ b/test/shipping.test.js
@@ -5,3 +5,44 @@ import { shippingFee } from "../src/shipping.js";
 test("module exports shippingFee", () => {
   assert.equal(typeof shippingFee, "function");
 });
+
+test("R1: tarifa base nacional es 4,90", () => {
+  assert.equal(shippingFee({ subtotal: 20, country: "ES", weightKg: 1 }), 4.9);
+});
+
+test("R2: pedido nacional con subtotal >= 50 es gratis", () => {
+  assert.equal(shippingFee({ subtotal: 50, country: "ES", weightKg: 1 }), 0);
+  assert.equal(shippingFee({ subtotal: 49.99, country: "ES", weightKg: 1 }), 4.9);
+});
+
+test("R3: internacional 12 € más 1,50 € por kg completo por encima de 2 kg", () => {
+  assert.equal(shippingFee({ subtotal: 20, country: "FR", weightKg: 1 }), 12);
+  assert.equal(shippingFee({ subtotal: 20, country: "FR", weightKg: 2 }), 12);
+  assert.equal(shippingFee({ subtotal: 20, country: "FR", weightKg: 4.7 }), 15);
+  assert.equal(shippingFee({ subtotal: 20, country: "FR", weightKg: 5 }), 16.5);
+});
+
+test("R3: internacional no tiene envío gratuito por subtotal", () => {
+  assert.equal(shippingFee({ subtotal: 100, country: "FR", weightKg: 1 }), 12);
+});
+
+test("R4: exprés suma 6 € a pedidos nacionales por debajo de 50", () => {
+  assert.equal(shippingFee({ subtotal: 20, country: "ES", weightKg: 1, express: true }), 10.9);
+});
+
+test("R4: exprés suma 6 € a pedidos internacionales", () => {
+  assert.equal(shippingFee({ subtotal: 20, country: "FR", weightKg: 4.7, express: true }), 21);
+});
+
+test("R5: peso negativo, NaN, no numérico o no finito lanza RangeError", () => {
+  for (const weightKg of [-1, NaN, "2", undefined, null, Infinity]) {
+    assert.throws(() => shippingFee({ subtotal: 20, country: "ES", weightKg }), RangeError);
+  }
+});
+
+test("Sin resolver: exprés nacional con subtotal >= 50 lanza error (ver OPEN_QUESTIONS.md)", () => {
+  assert.throws(
+    () => shippingFee({ subtotal: 60, country: "ES", weightKg: 1, express: true }),
+    /OPEN_QUESTIONS/
+  );
+});
