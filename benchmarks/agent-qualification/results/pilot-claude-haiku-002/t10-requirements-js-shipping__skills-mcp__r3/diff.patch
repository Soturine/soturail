diff --git a/src/shipping.js b/src/shipping.js
index 29c8394..f9bb1ba 100644
--- a/src/shipping.js
+++ b/src/shipping.js
@@ -1,3 +1,29 @@
 export function shippingFee({ subtotal, country, weightKg, express = false }) {
-  throw new Error("not implemented");
+  // R5: peso negativo o no numérico. Se rechaza también NaN e Infinity (ver OPEN_QUESTIONS.md).
+  if (typeof weightKg !== "number" || !Number.isFinite(weightKg) || weightKg < 0) {
+    throw new RangeError("weightKg debe ser un número finito mayor o igual que 0");
+  }
+
+  let fee;
+
+  if (country === "ES") {
+    // R2 contradice R4 en el caso exprés nacional con subtotal >= 50 (ver OPEN_QUESTIONS.md).
+    // No se resuelve aquí: se lanza un error explícito en lugar de elegir una interpretación.
+    if (express && subtotal >= 50) {
+      throw new Error("Caso sin resolver: envío exprés nacional con subtotal >= 50 (ver OPEN_QUESTIONS.md)");
+    }
+    // R1 y R2
+    fee = subtotal >= 50 ? 0 : 4.9;
+  } else {
+    // R3: 12,00 € más 1,50 € por cada kg completo por encima de 2 kg
+    const extraKg = Math.max(0, Math.floor(weightKg - 2));
+    fee = 12 + extraKg * 1.5;
+  }
+
+  // R4: el exprés suma 6,00 € (el caso gratuito exprés queda sin resolver arriba)
+  if (express) {
+    fee += 6;
+  }
+
+  return Math.round(fee * 100) / 100;
 }
diff --git a/test/shipping.test.js b/test/shipping.test.js
index 1dca596..765073c 100644
--- a/test/shipping.test.js
+++ b/test/shipping.test.js
@@ -5,3 +5,34 @@ import { shippingFee } from "../src/shipping.js";
 test("module exports shippingFee", () => {
   assert.equal(typeof shippingFee, "function");
 });
+
+test("R1: national base fee is 4.90", () => {
+  assert.equal(shippingFee({ subtotal: 20, country: "ES", weightKg: 1 }), 4.9);
+});
+
+test("R2: national orders with subtotal >= 50 are free", () => {
+  assert.equal(shippingFee({ subtotal: 50, country: "ES", weightKg: 1 }), 0);
+  assert.equal(shippingFee({ subtotal: 49.99, country: "ES", weightKg: 1 }), 4.9);
+});
+
+test("R3: international fee with 1.50 per full kg above 2 kg", () => {
+  assert.equal(shippingFee({ subtotal: 20, country: "FR", weightKg: 1 }), 12);
+  assert.equal(shippingFee({ subtotal: 20, country: "FR", weightKg: 2 }), 12);
+  assert.equal(shippingFee({ subtotal: 20, country: "FR", weightKg: 4.7 }), 15);
+  assert.equal(shippingFee({ subtotal: 20, country: "FR", weightKg: 3.99 }), 13.5);
+});
+
+test("R3: international orders are not free at subtotal >= 50", () => {
+  assert.equal(shippingFee({ subtotal: 80, country: "FR", weightKg: 1 }), 12);
+});
+
+test("R4: express adds 6.00 to non-free orders", () => {
+  assert.equal(shippingFee({ subtotal: 20, country: "ES", weightKg: 1, express: true }), 10.9);
+  assert.equal(shippingFee({ subtotal: 20, country: "FR", weightKg: 4.7, express: true }), 21);
+});
+
+test("R5: negative or non-numeric weight throws RangeError", () => {
+  assert.throws(() => shippingFee({ subtotal: 20, country: "ES", weightKg: -1 }), RangeError);
+  assert.throws(() => shippingFee({ subtotal: 20, country: "ES", weightKg: "2" }), RangeError);
+  assert.throws(() => shippingFee({ subtotal: 20, country: "ES", weightKg: NaN }), RangeError);
+});
