 export function shippingFee({ subtotal, country, weightKg, express = false }) {
-  throw new Error("not implemented");
+  // R5: peso negativo, no numérico o no finito
+  if (typeof weightKg !== "number" || !Number.isFinite(weightKg) || weightKg < 0) {
+    throw new RangeError("weightKg debe ser un número finito mayor o igual que 0");
+  }
+
+  const national = country === "ES";
+
+  // Conflicto R2 vs R4 (ver OPEN_QUESTIONS.md, Q1): sin resolver
+  if (national && express && subtotal >= 50) {
+    throw new Error("Caso sin resolver: envío exprés nacional con subtotal >= 50 € (ver OPEN_QUESTIONS.md, Q1)");
+  }
+
+  let fee;
+  if (national) {
+    // R1 y R2
+    fee = subtotal >= 50 ? 0 : 4.9;
+  } else {
+    // R3: 12 € + 1,50 € por cada kg completo por encima de 2 kg
+    fee = 12 + 1.5 * Math.max(0, Math.floor(weightKg - 2));
+  }
+
+  // R4: exprés suma 6 €
+  if (express) {
+    fee += 6;
+  }
+
+  return Math.round(fee * 100) / 100;
 }
