+test("neither input is modified, including nested objects", () => {
+  const base = { http: { timeoutMs: 1, retry: { attempts: 2 } } };
+  const override = { http: { retry: { attempts: 5 } } };
+  const merged = mergeConfig(base, override);
+  assert.deepEqual(base, { http: { timeoutMs: 1, retry: { attempts: 2 } } });
+  assert.deepEqual(override, { http: { retry: { attempts: 5 } } });
+  assert.deepEqual(merged, { http: { timeoutMs: 1, retry: { attempts: 5 } } });
