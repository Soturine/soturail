diff --git a/test/static.test.js b/test/static.test.js
index b9d6e6e..7177c37 100644
--- a/test/static.test.js
+++ b/test/static.test.js
@@ -14,3 +14,26 @@ test("serves a nested file", async () => {
 test("missing file is 404", async () => {
   assert.equal((await serveStatic(root, "/nope.txt")).status, 404);
 });
+
+test("files with '..' inside the name are still served", async () => {
+  assert.equal((await serveStatic(root, "/notes..v2.txt")).status, 200);
+});
+
+test("paths escaping the public root are not served", async () => {
+  for (const p of [
+    "/../secret.env",
+    "/%2e%2e/secret.env",
+    "/..%2fsecret.env",
+    "/..%5csecret.env",
+    "/%2e%2e%2f%2e%2e%2fsecret.env",
+    "/css/../../secret.env",
+  ]) {
+    const res = await serveStatic(root, p);
+    assert.equal(res.status, 404, p);
+    assert.doesNotMatch(res.body.toString(), /API_TOKEN/, p);
+  }
+});
+
+test("malformed percent-encoding is a 400, not a crash", async () => {
+  assert.equal((await serveStatic(root, "/%E0%A4%A")).status, 400);
+});
