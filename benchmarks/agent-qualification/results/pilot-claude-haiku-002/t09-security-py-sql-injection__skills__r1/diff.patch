diff --git a/directory/users.py b/directory/users.py
index 4cdd414..24b28ab 100644
--- a/directory/users.py
+++ b/directory/users.py
@@ -2,12 +2,17 @@ ROLES = {"viewer", "editor", "admin"}
 
 
 def search_users(conn, name_fragment):
-    query = f"SELECT id, name, email, role FROM users WHERE lower(name) LIKE lower('%{name_fragment}%') ORDER BY id"
-    return [dict(row) for row in conn.execute(query)]
+    # Escape LIKE wildcards so user input is matched literally, then bind it as a parameter.
+    escaped = name_fragment.replace("\\", "\\\\").replace("%", "\\%").replace("_", "\\_")
+    pattern = f"%{escaped}%"
+    query = "SELECT id, name, email, role FROM users WHERE lower(name) LIKE lower(?) ESCAPE '\\' ORDER BY id"
+    return [dict(row) for row in conn.execute(query, (pattern,))]
 
 
 def get_user_by_email(conn, email):
-    row = conn.execute("SELECT id, name, email, role FROM users WHERE email = '" + email + "'").fetchone()
+    row = conn.execute(
+        "SELECT id, name, email, role FROM users WHERE email = ?", (email,)
+    ).fetchone()
     return dict(row) if row else None
 
 
