+});
+
+test("requesting a page past the end returns no items", () => {
+  const result = paginate([1, 2, 3, 4, 5], 4, 2);
+  assert.deepEqual(result.items, []);
+  assert.equal(result.totalPages, 3);
+});
+
+test("empty result has zero pages", () => {
+  const result = paginate([], 1, 20);
+  assert.deepEqual(result.items, []);
+  assert.equal(result.totalPages, 0);
+});
+
 test("rejects a non-positive page size", () => {
