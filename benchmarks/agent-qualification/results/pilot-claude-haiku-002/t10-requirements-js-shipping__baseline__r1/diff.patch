diff --git a/src/shipping.js b/src/shipping.js
index 29c8394..951fa91 100644
--- a/src/shipping.js
+++ b/src/shipping.js
@@ -1,3 +1,35 @@
+const NATIONAL_COUNTRY = "ES";
+const NATIONAL_BASE_FEE = 4.9;
+const FREE_SHIPPING_THRESHOLD = 50;
+const INTERNATIONAL_BASE_FEE = 12;
+const INTERNATIONAL_INCLUDED_KG = 2;
+const INTERNATIONAL_FEE_PER_KG = 1.5;
+const EXPRESS_SURCHARGE = 6;
+
 export function shippingFee({ subtotal, country, weightKg, express = false }) {
-  throw new Error("not implemented");
+  if (typeof weightKg !== "number" || Number.isNaN(weightKg) || weightKg < 0) {
+    throw new RangeError("weightKg debe ser un número no negativo");
+  }
+
+  let fee;
+  if (country === NATIONAL_COUNTRY) {
+    if (subtotal >= FREE_SHIPPING_THRESHOLD) {
+      // Sin resolver: R2 (gratis) choca con R4 (exprés nunca gratis). Ver OPEN_QUESTIONS.md.
+      if (express) {
+        throw new Error("Caso sin resolver: envío exprés nacional con subtotal >= 50 (ver OPEN_QUESTIONS.md)");
+      }
+      fee = 0;
+    } else {
+      fee = NATIONAL_BASE_FEE;
+    }
+  } else {
+    const extraKg = Math.floor(Math.max(0, weightKg - INTERNATIONAL_INCLUDED_KG));
+    fee = INTERNATIONAL_BASE_FEE + extraKg * INTERNATIONAL_FEE_PER_KG;
+  }
+
+  if (express) {
+    fee += EXPRESS_SURCHARGE;
+  }
+
+  return Math.round(fee * 100) / 100;
 }
diff --git a/test/shipping.test.js b/test/shipping.test.js
index 1dca596..b6f8395 100644
--- a/test/shipping.test.js
+++ b/test/shipping.test.js
@@ -5,3 +5,39 @@ import { shippingFee } from "../src/shipping.js";
 test("module exports shippingFee", () => {
   assert.equal(typeof shippingFee, "function");
 });
+
+test("R1: national base fee is 4,90 €", () => {
+  assert.equal(shippingFee({ subtotal: 20, country: "ES", weightKg: 1 }), 4.9);
+});
+
+test("R2: national orders with subtotal >= 50 ship free", () => {
+  assert.equal(shippingFee({ subtotal: 50, country: "ES", weightKg: 1 }), 0);
+  assert.equal(shippingFee({ subtotal: 49.99, country: "ES", weightKg: 1 }), 4.9);
+});
+
+test("R3: international fee is 12 € plus 1,50 € per full kg above 2 kg", () => {
+  assert.equal(shippingFee({ subtotal: 20, country: "FR", weightKg: 1 }), 12);
+  assert.equal(shippingFee({ subtotal: 20, country: "FR", weightKg: 2 }), 12);
+  assert.equal(shippingFee({ subtotal: 20, country: "FR", weightKg: 4.7 }), 15);
+  assert.equal(shippingFee({ subtotal: 20, country: "FR", weightKg: 4 }), 15);
+});
+
+test("R3: international orders never get free shipping", () => {
+  assert.equal(shippingFee({ subtotal: 500, country: "FR", weightKg: 1 }), 12);
+});
+
+test("R4: express adds 6 € to national and international orders", () => {
+  assert.equal(shippingFee({ subtotal: 20, country: "ES", weightKg: 1, express: true }), 10.9);
+  assert.equal(shippingFee({ subtotal: 20, country: "FR", weightKg: 1, express: true }), 18);
+});
+
+test("R4 + R2 conflict: express national with subtotal >= 50 is unresolved (see OPEN_QUESTIONS.md)", () => {
+  assert.throws(() => shippingFee({ subtotal: 60, country: "ES", weightKg: 1, express: true }), Error);
+});
+
+test("R5: negative or non-numeric weight throws RangeError", () => {
+  assert.throws(() => shippingFee({ subtotal: 20, country: "ES", weightKg: -1 }), RangeError);
+  assert.throws(() => shippingFee({ subtotal: 20, country: "ES", weightKg: "2" }), RangeError);
+  assert.throws(() => shippingFee({ subtotal: 20, country: "ES", weightKg: NaN }), RangeError);
+  assert.throws(() => shippingFee({ subtotal: 20, country: "ES" }), RangeError);
+});
