-        fields.append(value)
+    value = []
+    quoted = False
+    in_quotes = False
+    i = 0
+    while i < len(line):
+        ch = line[i]
+        if in_quotes:
+            if ch == '"' and line[i + 1:i + 2] == '"':
+                value.append('"')
+                i += 1
+            elif ch == '"':
+                in_quotes = False
+            else:
+                value.append(ch)
+        elif ch == ",":
+            fields.append(_finish_field(value, quoted))
+            value, quoted = [], False
+        elif ch == '"' and not quoted and not "".join(value).strip():
+            in_quotes = quoted = True
+            value = []
+        elif quoted and ch.isspace():
+            pass
+        else:
+            value.append(ch)
+        i += 1
+    fields.append(_finish_field(value, quoted))
     return fields
 
 
+def _finish_field(value, quoted):
+    text = "".join(value)
+    return text if quoted else text.strip()
+
