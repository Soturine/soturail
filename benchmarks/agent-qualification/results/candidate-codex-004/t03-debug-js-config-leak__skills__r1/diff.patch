 import test from "node:test";
 import assert from "node:assert/strict";
 import { mergeConfig } from "../src/merge.js";
+import { configFor } from "../src/tenants.js";
+import { DEFAULTS } from "../src/defaults.js";
 
 test("override wins for scalars", () => {
   assert.equal(mergeConfig({ a: 1 }, { a: 2 }).a, 2);
@@ -10,3 +12,61 @@ test("nested values are merged", () => {
   const merged = mergeConfig({ http: { timeoutMs: 1, keep: true } }, { http: { timeoutMs: 2 } });
   assert.deepEqual(merged, { http: { timeoutMs: 2, keep: true } });
 });
+
+test("merging does not modify either input, including frozen nested values", () => {
+  const base = Object.freeze({ http: Object.freeze({
+    timeoutMs: 5000, retry: Object.freeze({ attempts: 2, backoffMs: 100 })
+  }) });
+  const override = Object.freeze({ http: Object.freeze({
+    retry: Object.freeze({ attempts: 5 })
+  }) });
+  assert.deepEqual(mergeConfig(base, override), {
+    http: { timeoutMs: 5000, retry: { attempts: 5, backoffMs: 100 } }
+  });
+});
+
+test("returned nested values are independent of both inputs", () => {
+  const base = { untouched: { values: [{ enabled: true }] }, regions: ["eu"] };
+  const override = { added: { values: [{ count: 1 }] }, regions: ["us"], scalar: null };
+  const merged = mergeConfig(base, override);
+  assert.deepEqual(merged.regions, ["us"]);
+  assert.equal(merged.scalar, null);
+  merged.untouched.values[0].enabled = false;
+  merged.added.values[0].count = 9;
+  merged.regions.push("eu");
+  assert.deepEqual(base, { untouched: { values: [{ enabled: true }] }, regions: ["eu"] });
+  assert.deepEqual(override, { added: { values: [{ count: 1 }] }, regions: ["us"], scalar: null });
+});
+
+test("serving acme does not change subsequent tenants' timeout and retries", () => {
+  configFor("acme");
+  for (const tenant of ["globex", "initech", "unknown"]) {
+    assert.deepEqual(configFor(tenant).http, {
+      timeoutMs: 5000, retry: { attempts: 2, backoffMs: 100 }
+    });
+  }
+});
+
+test("tenant settings remain isolated across request orders and result mutations", () => {
+  const defaults = structuredClone(DEFAULTS);
+  for (const order of [
+    ["acme", "globex", "initech", "unknown"],
+    ["globex", "initech", "acme", "unknown"],
+    ["initech", "acme", "globex", "unknown"]
+  ]) {
+    for (const tenant of order) {
+      const config = configFor(tenant);
+      assert.deepEqual(config.http, tenant === "acme"
+        ? { timeoutMs: 30000, retry: { attempts: 5, backoffMs: 100 } }
+        : defaults.http);
+      assert.deepEqual(config.headers, tenant === "globex"
+        ? { ...defaults.headers, "x-tenant": "globex" } : defaults.headers);
+      assert.deepEqual(config.allowedRegions, defaults.allowedRegions);
+      config.http.timeoutMs = 1;
+      config.http.retry.attempts = 99;
+      config.headers["x-tenant"] = "modified";
+      config.allowedRegions.push("modified");
+      assert.deepEqual(DEFAULTS, defaults);
+    }
+  }
+});
