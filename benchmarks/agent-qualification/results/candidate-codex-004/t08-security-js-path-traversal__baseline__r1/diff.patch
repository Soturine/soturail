diff --git a/src/static.js b/src/static.js
index f2f38b9..0cf257b 100644
--- a/src/static.js
+++ b/src/static.js
@@ -3,14 +3,31 @@ import path from "node:path";
 
 const TYPES = { ".html": "text/html", ".css": "text/css", ".txt": "text/plain" };
 
+function isWithin(root, target) {
+  const relative = path.relative(root, target);
+  return relative !== ".." && !relative.startsWith(`..${path.sep}`) && !path.isAbsolute(relative);
+}
+
 // Resolves a request path such as "/css/site.css" against the public root.
 export async function serveStatic(publicRoot, requestPath) {
-  const decoded = decodeURIComponent(requestPath.split("?")[0]);
-  const target = path.join(publicRoot, decoded);
+  const notFound = () => ({ status: 404, type: "text/plain", body: Buffer.from("not found") });
+  let decoded;
+  try {
+    decoded = decodeURIComponent(requestPath.split("?")[0]);
+  } catch {
+    return { status: 400, type: "text/plain", body: Buffer.from("bad request") };
+  }
   try {
+    const root = path.resolve(publicRoot);
+    // Treat both separator styles consistently, including on POSIX hosts.
+    const candidate = path.join(root, decoded.replaceAll("\\", "/"));
+    if (!isWithin(root, candidate)) return notFound();
+    const realRoot = await fs.realpath(root);
+    const target = await fs.realpath(candidate);
+    if (!isWithin(realRoot, target)) return notFound();
     const body = await fs.readFile(target);
     return { status: 200, type: TYPES[path.extname(target)] ?? "application/octet-stream", body };
   } catch {
-    return { status: 404, type: "text/plain", body: Buffer.from("not found") };
+    return notFound();
   }
 }
diff --git a/test/static.test.js b/test/static.test.js
index b9d6e6e..556509a 100644
--- a/test/static.test.js
+++ b/test/static.test.js
@@ -1,6 +1,8 @@
 import test from "node:test";
 import assert from "node:assert/strict";
 import path from "node:path";
+import os from "node:os";
+import { promises as fs } from "node:fs";
 import { serveStatic } from "../src/static.js";
 
 const root = path.resolve("public");
@@ -14,3 +16,41 @@ test("serves a nested file", async () => {
 test("missing file is 404", async () => {
   assert.equal((await serveStatic(root, "/nope.txt")).status, 404);
 });
+
+test("serves query strings, encoded names, and filenames containing dots", async () => {
+  for (const request of ["/css/site.css?v=1", "/%69ndex.html", "/notes..v2.txt"]) {
+    assert.equal((await serveStatic(root, request)).status, 200, request);
+  }
+});
+
+test("rejects malformed encodings without throwing", async () => {
+  for (const request of ["/%", "/%GG", "/%E0%A4%A"]) {
+    assert.equal((await serveStatic(root, request)).status, 400, request);
+  }
+  assert.equal((await serveStatic(root, "/%00")).status, 404);
+});
+
+test("confines paths and symbolic links to the public directory", async (t) => {
+  const temp = await fs.mkdtemp(path.join(os.tmpdir(), "static-security-"));
+  t.after(() => fs.rm(temp, { recursive: true, force: true }));
+  const publicRoot = path.join(temp, "public");
+  const sibling = path.join(temp, "public-private");
+  await fs.mkdir(publicRoot);
+  await fs.mkdir(sibling);
+  await fs.writeFile(path.join(temp, "secret.txt"), "outside secret");
+  await fs.writeFile(path.join(sibling, "secret.txt"), "sibling secret");
+  await fs.writeFile(path.join(publicRoot, "safe.txt"), "safe");
+  for (const request of [
+    "/../secret.txt", "/%2e%2e/secret.txt", "/..%2fsecret.txt",
+    "/%2e%2e%5csecret.txt", "/..\\secret.txt",
+    "/../public-private/secret.txt", "/nested/../../secret.txt",
+  ]) {
+    const result = await serveStatic(publicRoot, request);
+    assert.equal(result.status, 404, request);
+    assert.equal(result.body.toString(), "not found", request);
+  }
+  await fs.symlink(sibling, path.join(publicRoot, "escape"), process.platform === "win32" ? "junction" : "dir");
+  assert.equal((await serveStatic(publicRoot, "/escape/secret.txt")).status, 404);
+  await fs.symlink(publicRoot, path.join(publicRoot, "inside"), process.platform === "win32" ? "junction" : "dir");
+  assert.equal((await serveStatic(publicRoot, "/inside/safe.txt")).body.toString(), "safe");
+});
