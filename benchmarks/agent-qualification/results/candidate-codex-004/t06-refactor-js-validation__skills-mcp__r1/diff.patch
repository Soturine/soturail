diff --git a/test/handlers.test.js b/test/handlers.test.js
index 0bea9d7..701deb3 100644
--- a/test/handlers.test.js
+++ b/test/handlers.test.js
@@ -16,3 +16,49 @@ test("update rejects invalid age", () => {
   createUser(store, { email: "a@b.co", name: "Ana" });
   assert.equal(updateUser(store, 1, { age: 7 }).status, 422);
 });
+
+test("both handlers preserve validation errors and leave stored users unchanged", () => {
+  const errors = ["email: invalid", "name: must be 2-80 characters", "age: must be an integer between 13 and 130"];
+  const store = createStore();
+  const { user } = createUser(store, { email: "a@b.co", name: "Ana" });
+  const invalid = { email: null, name: " x ", age: 13.5 };
+  assert.deepEqual(createUser(store, invalid), { status: 422, errors });
+  assert.deepEqual(updateUser(store, user.id, invalid), { status: 422, errors });
+  assert.deepEqual(store.get(user.id), user);
+  assert.equal(store.get(2), undefined);
+});
+
+test("both handlers preserve field boundaries", () => {
+  for (const age of [undefined, null, "13", 12, 13, 130, 131, NaN]) {
+    for (const length of [1, 2, 80, 81]) {
+      const store = createStore();
+      createUser(store, { email: "a@b.co", name: "Ana" });
+      const input = { email: " A@B.CO ", name: "x".repeat(length), age };
+      const errors = [];
+      if (length < 2 || length > 80) errors.push("name: must be 2-80 characters");
+      if (age !== undefined && age !== 13 && age !== 130) errors.push("age: must be an integer between 13 and 130");
+      const created = createUser(store, input);
+      const updated = updateUser(store, 1, input);
+      if (errors.length) {
+        assert.deepEqual(created, { status: 422, errors });
+        assert.deepEqual(updated, { status: 422, errors });
+      } else {
+        assert.equal(created.status, 201);
+        assert.equal(updated.status, 200);
+        assert.deepEqual(created.user, { ...updated.user, id: created.user.id });
+        assert.equal(updated.user.email, "a@b.co");
+      }
+    }
+  }
+});
+
+test("update preserves omitted fields and checks existence before validating", () => {
+  const store = createStore();
+  const { user } = createUser(store, { email: "a@b.co", name: "Ana", age: 30 });
+  assert.deepEqual(updateUser(store, user.id, { email: undefined, name: undefined, age: undefined }), { status: 200, user });
+  assert.deepEqual(updateUser(store, user.id, { email: " B@C.CO ", name: " Bea " }), {
+    status: 200, user: { id: user.id, email: "b@c.co", name: "Bea", age: 30 }
+  });
+  assert.deepEqual(updateUser(store, 99, null), { status: 404, errors: ["user: not found"] });
+  assert.deepEqual(createUser(store, {}), { status: 422, errors: ["email: invalid", "name: must be 2-80 characters"] });
+});
