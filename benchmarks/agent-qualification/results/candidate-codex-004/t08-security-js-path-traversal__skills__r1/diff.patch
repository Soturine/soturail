+    const decoded = decodeURIComponent(requestPath.split("?")[0]);
+    // Reject Windows separators and alternate data streams on every platform.
+    if (/[\\\u0000:]/.test(decoded)) throw new Error("Invalid path");
+    const root = path.resolve(publicRoot);
+    const target = path.resolve(root, `.${path.sep}${decoded}`);
+    if (!isWithin(root, target)) throw new Error("Path outside public root");
+    const realRoot = await fs.realpath(root);
+    const realTarget = await fs.realpath(target);
+    if (!isWithin(realRoot, realTarget)) throw new Error("Link outside public root");
+    const body = await fs.readFile(realTarget);
     return { status: 200, type: TYPES[path.extname(target)] ?? "application/octet-stream", body };
   } catch {
