+
+test("returns the final partial page", () => {
+  assert.deepEqual(paginate([1, 2, 3, 4, 5], 3, 2), {
+    items: [5], page: 3, pageSize: 2, totalItems: 5, totalPages: 3
+  });
+  assert.deepEqual(paginate([1, 2, 3, 4, 5], 4, 2).items, []);
+});
+
+test("returns results when there are fewer items than the page size", () => {
+  const result = paginate([1], 1, 20);
+  assert.deepEqual(result.items, [1]);
+  assert.equal(result.totalPages, 1);
+});
+
+test("empty results have zero pages", () => {
+  const result = paginate([], 1, 20);
+  assert.deepEqual(result.items, []);
+  assert.equal(result.totalPages, 0);
+});
+
+test("search returns the final partial page of matching results", () => {
