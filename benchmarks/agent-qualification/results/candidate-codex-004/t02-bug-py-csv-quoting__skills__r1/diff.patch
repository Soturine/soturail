+    def test_quoted_commas_and_escaped_quotes(self):
+        rows = parse_customers(
+            'nome,endereco,observacao\nAna,"Rua A, 10","Disse ""oi"", depois saiu"\n'
+        )
+        self.assertEqual(rows, [{
+            "nome": "Ana",
+            "endereco": "Rua A, 10",
+            "observacao": 'Disse "oi", depois saiu',
+        }])
+
+    def test_quoted_header_and_empty_fields(self):
+        rows = parse_customers('"nome, completo",endereco,nota\n"Ana",,\n')
+        self.assertEqual(rows, [{"nome, completo": "Ana", "endereco": "", "nota": ""}])
+
+    def test_spaces_and_blank_lines(self):
+        rows = parse_customers('\n nome , endereco \n\n Ana , " Rua A, 10 " \n')
+        self.assertEqual(rows, [{"nome": "Ana", "endereco": " Rua A, 10 "}])
