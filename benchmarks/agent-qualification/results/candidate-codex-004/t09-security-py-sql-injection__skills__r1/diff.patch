+    def test_sql_injection_is_literal(self):
+        for payload in ("' OR 1=1 --", "') OR 1=1 --", "'; DROP TABLE users; --"):
+            with self.subTest(payload=payload):
+                self.assertEqual(search_users(self.conn, payload), [])
+                self.assertIsNone(get_user_by_email(self.conn, payload))
+        self.assertEqual(len(search_users(self.conn, "")), 2)
+
+    def test_quotes_and_sql_text_round_trip(self):
+        name = "O'Brien ') OR 1=1 --"
+        email = "o'brien@x.io"
+        seed(self.conn, [(name, email, "editor")])
+        self.assertEqual([u["name"] for u in search_users(self.conn, "') OR 1=1 --")], [name])
+        self.assertEqual(get_user_by_email(self.conn, email)["name"], name)
+
+    def test_search_metacharacters_are_literal(self):
+        for fragment in ("%", "_", "!", "!%_", "\\"):
+            name = "Literal " + fragment
+            seed(self.conn, [(name, fragment + "@x.io", "viewer")])
+            self.assertEqual([u["name"] for u in search_users(self.conn, fragment)], [name])
+
+    def test_search_case_and_order(self):
+        seed(self.conn, [("ANA Silva", "silva@x.io", "viewer")])
+        self.assertEqual([u["name"] for u in search_users(self.conn, "ANA")], ["Ana Lima", "ANA Silva"])
+
+    def test_missing_email(self):
+        self.assertIsNone(get_user_by_email(self.conn, "missing@x.io"))
+
+    def test_role_updates(self):
+        for role in ("viewer", "editor", "admin"):
