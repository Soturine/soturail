 import test from "node:test";
 import assert from "node:assert/strict";
 import { paginate } from "../src/paginate.js";
+import { search } from "../src/search.js";
 
 test("first page of an evenly divisible list", () => {
   const result = paginate([1, 2, 3, 4], 1, 2);
@@ -11,3 +12,30 @@ test("first page of an evenly divisible list", () => {
 test("rejects a non-positive page size", () => {
   assert.throws(() => paginate([1], 1, 0), RangeError);
 });
+
+test("includes the final partial page", () => {
+  const result = paginate([1, 2, 3, 4, 5], 3, 2);
+  assert.deepEqual(result.items, [5]);
+  assert.equal(result.totalPages, 3);
+});
+
+test("includes a first page smaller than the page size", () => {
+  const result = paginate([1], 1, 20);
+  assert.deepEqual(result.items, [1]);
+  assert.equal(result.totalPages, 1);
+});
+
+test("empty lists and pages past the end return no items", () => {
+  assert.equal(paginate([], 1, 2).totalPages, 0);
+  assert.deepEqual(paginate([], 1, 2).items, []);
+  assert.deepEqual(paginate([1, 2, 3], 3, 2).items, []);
+});
+
+test("search returns the final partial page of matching results", () => {
+  const catalog = ["Match one", "Other", "Match two", "Match three"]
+    .map((name) => ({ name }));
+  const result = search(catalog, "match", { page: 2, pageSize: 2 });
+  assert.deepEqual(result.items, [{ name: "Match three" }]);
+  assert.equal(result.totalItems, 3);
+  assert.equal(result.totalPages, 2);
+});
