diff --git a/test/merge.test.js b/test/merge.test.js
index db17da7..4f2b5e6 100644
--- a/test/merge.test.js
+++ b/test/merge.test.js
@@ -1,6 +1,8 @@
 import test from "node:test";
 import assert from "node:assert/strict";
 import { mergeConfig } from "../src/merge.js";
+import { DEFAULTS } from "../src/defaults.js";
+import { configFor } from "../src/tenants.js";
 
 test("override wins for scalars", () => {
   assert.equal(mergeConfig({ a: 1 }, { a: 2 }).a, 2);
@@ -10,3 +12,49 @@ test("nested values are merged", () => {
   const merged = mergeConfig({ http: { timeoutMs: 1, keep: true } }, { http: { timeoutMs: 2 } });
   assert.deepEqual(merged, { http: { timeoutMs: 2, keep: true } });
 });
+
+test("merging nested overrides leaves both inputs unchanged", () => {
+  const base = { http: { timeoutMs: 5000, retry: { attempts: 2, backoffMs: 100 } } };
+  const override = { http: { timeoutMs: 30000, retry: { attempts: 5 } } };
+  const beforeBase = structuredClone(base);
+  const beforeOverride = structuredClone(override);
+  assert.deepEqual(mergeConfig(base, override), {
+    http: { timeoutMs: 30000, retry: { attempts: 5, backoffMs: 100 } }
+  });
+  assert.deepEqual(base, beforeBase);
+  assert.deepEqual(override, beforeOverride);
+});
+
+test("returned objects and arrays do not alias either input", () => {
+  const base = { nested: { items: [{ value: 1 }] }, regions: ["eu"] };
+  const override = { added: { items: [{ value: 2 }] }, regions: ["us"] };
+  const beforeBase = structuredClone(base);
+  const beforeOverride = structuredClone(override);
+  const merged = mergeConfig(base, override);
+  assert.deepEqual(merged.regions, ["us"]);
+  merged.nested.items[0].value = 10;
+  merged.added.items[0].value = 20;
+  merged.regions.push("apac");
+  assert.deepEqual(base, beforeBase);
+  assert.deepEqual(override, beforeOverride);
+  assert.deepEqual(mergeConfig(base).regions, ["eu"]);
+});
+
+test("tenant settings stay isolated across request orders and caller mutations", () => {
+  const defaults = structuredClone(DEFAULTS);
+  for (const order of [["acme", "globex", "initech"], ["initech", "globex", "acme"]]) {
+    for (const tenant of order) {
+      const config = configFor(tenant);
+      assert.deepEqual(config.http, {
+        timeoutMs: tenant === "acme" ? 30000 : 5000,
+        retry: { attempts: tenant === "acme" ? 5 : 2, backoffMs: 100 }
+      });
+      config.http.timeoutMs = 1;
+      config.http.retry.attempts = 99;
+      config.headers["user-agent"] = "changed";
+      config.allowedRegions.push("apac");
+    }
+  }
+  assert.deepEqual(DEFAULTS, defaults);
+  assert.deepEqual(configFor("unknown"), defaults);
+});
