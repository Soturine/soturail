diff --git a/test/limiter.test.js b/test/limiter.test.js
index e3eaf9d..d4ab4ba 100644
--- a/test/limiter.test.js
+++ b/test/limiter.test.js
@@ -15,3 +15,56 @@ test("blocks after limit within a window and resets next window", () => {
 test("validates options", () => {
   assert.throws(() => createLimiter({ limit: 0, windowMs: 10 }), RangeError);
 });
+
+test("overrides replace defaults and remaining observes independent budgets", () => {
+  let t = 0;
+  const limiter = createLimiter({
+    limit: 2, windowMs: 1000, now: () => t,
+    overrides: { premium: 3, restricted: 1 }
+  });
+  for (const [key, budget] of [["premium", 3], ["restricted", 1], ["default", 2], ["toString", 2]]) {
+    assert.equal(limiter.remaining(key), budget);
+    assert.equal(limiter.remaining(key), budget);
+    for (let used = 1; used <= budget; used++) {
+      assert.equal(limiter.tryAcquire(key), true);
+      assert.equal(limiter.remaining(key), budget - used);
+    }
+    assert.equal(limiter.tryAcquire(key), false);
+    assert.equal(limiter.remaining(key), 0);
+  }
+  t = 999;
+  assert.equal(limiter.remaining("premium"), 0);
+  t = 1000;
+  assert.equal(limiter.remaining("premium"), 3);
+  assert.equal(limiter.remaining("restricted"), 1);
+  assert.equal(limiter.remaining("default"), 2);
+  assert.equal(limiter.tryAcquire("premium"), true);
+  assert.equal(limiter.remaining("premium"), 2);
+});
+
+test("remaining works without overrides", () => {
+  const limiter = createLimiter({ limit: 2, windowMs: 1000 });
+  assert.equal(limiter.remaining("a"), 2);
+  limiter.tryAcquire("a");
+  assert.equal(limiter.remaining("a"), 1);
+  assert.equal(limiter.remaining("b"), 2);
+});
+
+test("accepts Map overrides and copies entries", () => {
+  const key = {};
+  const overrides = new Map([[key, 1]]);
+  const limiter = createLimiter({ limit: 2, windowMs: 1000, overrides });
+  overrides.set(key, 5);
+  assert.equal(limiter.remaining(key), 1);
+  assert.equal(limiter.tryAcquire(key), true);
+  assert.equal(limiter.tryAcquire(key), false);
+  assert.equal(limiter.remaining("other"), 2);
+});
+
+test("validates every override limit", () => {
+  for (const value of [0, -1, 1.5, NaN, Infinity, "2", undefined, null]) {
+    for (const overrides of [{ a: value }, new Map([["a", value]])]) {
+      assert.throws(() => createLimiter({ limit: 2, windowMs: 1000, overrides }), RangeError);
+    }
+  }
+});
