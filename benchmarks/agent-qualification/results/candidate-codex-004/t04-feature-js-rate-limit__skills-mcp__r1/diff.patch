@@ -4,12 +4,24 @@ Fixed-window rate limiter.
 
 ```js
 import { createLimiter } from "./src/limiter.js";
-const limiter = createLimiter({ limit: 100, windowMs: 60_000 });
+const limiter = createLimiter({
+  limit: 100,
+  windowMs: 60_000,
+  overrides: { "client-a": 200 }
+});
+limiter.remaining("client-a"); // 200
 limiter.tryAcquire("client-a"); // true while the key has budget in the current window
+limiter.remaining("client-a"); // 199
 ```
 
 Options:
 
 - `limit` (positive integer, required) — requests allowed per key per window.
 - `windowMs` (positive integer, required) — window length.
+- `overrides` (object or `Map`, optional) — key-to-limit entries replacing `limit` for those keys. Every override must be a positive integer. Defaults to no overrides; entries are copied when the limiter is created.
 - `now` (function, optional) — clock, defaults to `Date.now`. Windows start at multiples of `windowMs`.
+
+Methods:
+
+- `tryAcquire(key)` — returns `true` and consumes one request if the key has budget; otherwise returns `false` without consuming a request.
+- `remaining(key)` — returns the key's unused request budget in the current window without consuming a request. Unused keys have their full limit, exhausted keys return `0`, and budgets reset at the next window boundary. Keys have independent budgets.
