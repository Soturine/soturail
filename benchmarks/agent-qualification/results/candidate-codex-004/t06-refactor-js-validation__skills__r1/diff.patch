diff --git a/test/handlers.test.js b/test/handlers.test.js
index 0bea9d7..7e65794 100644
--- a/test/handlers.test.js
+++ b/test/handlers.test.js
@@ -16,3 +16,47 @@ test("update rejects invalid age", () => {
   createUser(store, { email: "a@b.co", name: "Ana" });
   assert.equal(updateUser(store, 1, { age: 7 }).status, 422);
 });
+
+test("create and update preserve validation errors and leave stored data unchanged", () => {
+  const store = createStore();
+  const { user } = createUser(store, { email: "a@b.co", name: "Ana", age: 30 });
+  const invalid = { email: null, name: " x ", age: 12 };
+  const expected = { status: 422, errors: [
+    "email: invalid",
+    "name: must be 2-80 characters",
+    "age: must be an integer between 13 and 130"
+  ] };
+  assert.deepEqual(createUser(store, invalid), expected);
+  assert.deepEqual(updateUser(store, user.id, invalid), expected);
+  assert.deepEqual(store.get(user.id), user);
+  assert.equal(store.get(2), undefined);
+});
+
+test("update preserves omitted fields and normalizes supplied fields", () => {
+  const store = createStore();
+  const { user } = createUser(store, { email: "a@b.co", name: "Ana", age: 30 });
+  assert.deepEqual(updateUser(store, user.id, { email: undefined, name: undefined, age: undefined }),
+    { status: 200, user });
+  assert.deepEqual(updateUser(store, user.id, { email: " B@C.CO ", name: " Bea " }),
+    { status: 200, user: { id: user.id, email: "b@c.co", name: "Bea", age: 30 } });
+  assert.deepEqual(updateUser(store, 99, { email: null }),
+    { status: 404, errors: ["user: not found"] });
+});
+
+test("both handlers preserve name and age boundaries", () => {
+  for (const name of ["ab", "a".repeat(80)]) {
+    for (const age of [13, 130]) {
+      const store = createStore();
+      const input = { email: "a@b.co", name, age };
+      assert.equal(createUser(store, input).status, 201);
+      assert.equal(updateUser(store, 1, input).status, 200);
+    }
+  }
+  for (const patch of [{}, { name: "a" }, { name: "a".repeat(81) },
+    { age: null }, { age: "13" }, { age: 13.5 }, { age: 131 }]) {
+    const store = createStore();
+    createUser(store, { email: "a@b.co", name: "Ana" });
+    assert.equal(createUser(store, patch).status, 422);
+    assert.equal(updateUser(store, 1, patch).status, Object.keys(patch).length ? 422 : 200);
+  }
+});
