diff --git a/test/limiter.test.js b/test/limiter.test.js
index e3eaf9d..c455a1f 100644
--- a/test/limiter.test.js
+++ b/test/limiter.test.js
@@ -15,3 +15,51 @@ test("blocks after limit within a window and resets next window", () => {
 test("validates options", () => {
   assert.throws(() => createLimiter({ limit: 0, windowMs: 10 }), RangeError);
 });
+
+test("overrides replace the default and keys have independent budgets", () => {
+  const limiter = createLimiter({ limit: 2, windowMs: 1000, overrides: { low: 1, high: 3 } });
+  for (const [key, budget] of [["low", 1], ["high", 3], ["default", 2]]) {
+    assert.equal(limiter.remaining(key), budget);
+    assert.equal(limiter.remaining(key), budget);
+    for (let i = 0; i < budget; i++) {
+      assert.equal(limiter.tryAcquire(key), true);
+      assert.equal(limiter.remaining(key), budget - i - 1);
+    }
+    assert.equal(limiter.tryAcquire(key), false);
+    assert.equal(limiter.remaining(key), 0);
+  }
+  assert.equal(limiter.remaining("unused"), 2);
+});
+
+test("remaining resets default and override budgets at fixed-window boundaries", () => {
+  let t = 999;
+  const limiter = createLimiter({ limit: 2, windowMs: 1000, now: () => t, overrides: { a: 1 } });
+  limiter.tryAcquire("a");
+  limiter.tryAcquire("b");
+  assert.equal(limiter.remaining("a"), 0);
+  assert.equal(limiter.remaining("b"), 1);
+  t = 1000;
+  assert.equal(limiter.remaining("a"), 1);
+  assert.equal(limiter.remaining("b"), 2);
+  assert.equal(limiter.tryAcquire("a"), true);
+  assert.equal(limiter.remaining("a"), 0);
+});
+
+test("validates override limits and container", () => {
+  for (const value of [0, -1, 1.5, NaN, Infinity, "2", null, undefined]) {
+    assert.throws(() => createLimiter({ limit: 2, windowMs: 10, overrides: { a: value } }), RangeError);
+  }
+  for (const overrides of [null, [], "a", 1]) {
+    assert.throws(() => createLimiter({ limit: 2, windowMs: 10, overrides }), TypeError);
+  }
+});
+
+test("uses only own overrides, handles prototype names, and copies limits", () => {
+  const overrides = Object.assign(Object.create({ inherited: 1 }), { a: 3, constructor: 4 });
+  const limiter = createLimiter({ limit: 2, windowMs: 1000, overrides });
+  overrides.a = 1;
+  assert.equal(limiter.remaining("a"), 3);
+  assert.equal(limiter.remaining("inherited"), 2);
+  assert.equal(limiter.remaining("constructor"), 4);
+  assert.equal(limiter.remaining("toString"), 2);
+});
