@@ -4,12 +4,21 @@ Fixed-window rate limiter.
 
 ```js
 import { createLimiter } from "./src/limiter.js";
-const limiter = createLimiter({ limit: 100, windowMs: 60_000 });
+const limiter = createLimiter({
+  limit: 100,
+  windowMs: 60_000,
+  overrides: { "client-a": 200, "client-b": 10 }
+});
+limiter.remaining("client-a"); // 200
 limiter.tryAcquire("client-a"); // true while the key has budget in the current window
+limiter.remaining("client-a"); // 199
 ```
 
 Options:
 
 - `limit` (positive integer, required) — requests allowed per key per window.
 - `windowMs` (positive integer, required) — window length.
+- `overrides` (object, optional) — own string keys map to positive integer limits that replace `limit` for those keys. Other keys use `limit`. Values are validated and copied when the limiter is created.
 - `now` (function, optional) — clock, defaults to `Date.now`. Windows start at multiples of `windowMs`.
+
+`tryAcquire(key)` consumes one request and returns `true` when budget is available; otherwise it returns `false`. `remaining(key)` returns the unused budget in the current window without consuming a request. It returns the full applicable limit for an unused key or a new window, and zero after exhaustion. Keys have independent budgets.
